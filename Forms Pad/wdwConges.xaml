<Window x:Class="wdwConges"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lakey"
        mc:Ignorable="d"
        Title="wdwConges" Height="450" MaxWidth="800" Loaded="Window_Loaded" Topmost="True" Icon="/Lakey;component/MyIco.ico">
    <Grid Background="#FF000946">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="100"><Run Text="Agent "/><Run Text=": "/></TextBlock>
                <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                <Grid>
                    <ComboBox x:Name="CbxAgent" Width="350" Height="26" FontSize="14" VerticalAlignment="Bottom" />
                    <TextBlock  x:Name="TblIndicationCbxAgent" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray"><Run Text=" "/><Run Text="Agent"/></TextBlock>
                </Grid>
                <Grid Margin="8,0,0,0">
                    <ComboBox x:Name="CbxNumMatr" Width="134" Height="26" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" IsEnabled="False" Margin="0,0,-9,0" />
                    <TextBlock  x:Name="TblIndicationNumMatr" Text="N° Matricule " VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray" Margin="5,5,0,5" HorizontalAlignment="Left" Width="98"/>
                </Grid>

            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="109"><Run Text="Site "/><Run Text=": "/></TextBlock>
                <Grid>
                    <TextBox x:Name="TbxSite" Width="350" Height="26" FontSize="14" VerticalAlignment="Bottom" IsReadOnly="True" />
                </Grid>
                <TextBlock Text=" En " Foreground="White" VerticalAlignment="Center"/>
                <TextBox  x:Name="TbxTypCtr" Width="124" Height="26" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" IsReadOnly="True" />
            </StackPanel>
            <TextBox x:Name="TbxObs" Width="360" Height="26" FontSize="14" VerticalAlignment="Bottom" IsReadOnly="True"  Visibility="Collapsed"/>

            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"  Margin="5" >
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Début :"  Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="109"/>
                            <DatePicker  x:Name="dtpDebut" FontSize="12" VerticalAlignment="Center" Text=""  Width="141"  Margin="5"  />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Fin :"  Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="109"/>
                            <DatePicker  x:Name="dtpFin" FontSize="12" VerticalAlignment="Center" Text=""  Width="139" Margin="5" />
                        </StackPanel>
                    </StackPanel>
                    <GroupBox Header="Données externes" Grid.Column="1" Width="220" HorizontalAlignment="Left" FontSize="8" Foreground="#FF9B9B9B" >
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock MinWidth="25" Margin="0,5,5,5" FontSize="12"  VerticalAlignment="Center" Foreground="White" Width="95"><Run Text="Congé mensuel "/><Run Text=": "/></TextBlock>
                                <TextBox x:Name="TbxMensuelCong" Width="60" FontSize="14" Text="2,5" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock MinWidth="25" Margin="0,5,5,5" FontSize="12"  VerticalAlignment="Center" Foreground="White" Width="95"><Run Text="Franchise "/><Run Text=": "/></TextBlock>
                                <TextBox x:Name="TbxFranchise" Width="60" FontSize="14" VerticalAlignment="Bottom" Text="0" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock MinWidth="25" Margin="0,5,5,5" FontSize="12"  VerticalAlignment="Center" Foreground="White" Width="100"><Run Text="Franchise "/><Run Text=": "/></TextBlock>
                <TextBox x:Name="TbxJrPris" Width="60" FontSize="14" Text="0" />
            </StackPanel>
            <Button x:Name="btnValider" Content="VALIDER" Margin="200,15" Height="31" IsEnabled="False"/>
            <GroupBox Header="RESULTATS " Grid.Column="1"  FontSize="8" Foreground="#FF9B9B9B" Background="#FF252E68" Margin="150,10,150,0" >
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5,5,5,0">
                        <TextBlock MinWidth="25" Margin="0,5,5,5" FontSize="12"  VerticalAlignment="Center" Foreground="White" Width="95"><Run Text="Durée due"/><Run Text=": "/></TextBlock>
                        <TextBox x:Name="TbxJrsDuree" Width="60" FontSize="14" Text="0" IsReadOnly="True" />
                        <TextBlock Margin="5,5,5,5" FontSize="12"  VerticalAlignment="Center" Foreground="White" Text="jours"/>
                        <TextBlock MinWidth="25" Margin="15,5,5,5" FontSize="12"  VerticalAlignment="Center" Foreground="White" Width="72"><Run Text="Durée "/><Run Text="nette "/><Run Text=": "/></TextBlock>
                        <TextBox x:Name="TbxDureeNet" Width="87" TextAlignment="Center" FontSize="14" Text="0" FontWeight="Bold" IsReadOnly="True" Background="#FF000946" Foreground="White" BorderBrush="White" BorderThickness="1,2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Margin="5,5,5,5" FontSize="12"  VerticalAlignment="Center" Foreground="White" Text="jours"/>

                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5,0,5,5">
                        <TextBlock MinWidth="25" Margin="0,5,5,5" FontSize="12"  VerticalAlignment="Center" Foreground="White" Width="95"/>
                        <TextBox x:Name="TbxMoisDuree" Width="60" FontSize="14" VerticalAlignment="Bottom" Text="0" IsReadOnly="True" />
                        <TextBlock Margin="5,5,5,5" FontSize="12"  VerticalAlignment="Center" Foreground="White" Text="mois"/>
                        <Button x:Name="btnPtGal" Content="VUE GLOBALE" Margin="40,0,0,0" Width="157" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Background="#FFC0C9FF" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

        </StackPanel>

    </Grid>
</Window>
