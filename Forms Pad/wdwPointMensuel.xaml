<Window x:Class="wdwPointMensuel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lakey"
        mc:Ignorable="d"
        Title="wdwPointMensuel" Height="450" Width="800" Icon="/Lakey;component/MyIco.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <StackPanel  Grid.Row="0" Background="#FF01093A" >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition MaxHeight="120" MinHeight=" 5"/>
                    <RowDefinition Height="4*" MinHeight="40"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#FFFF9494"  Height="5">
                    <TextBlock x:Name="tbkNomFichier" Visibility="Hidden"/>
                </Border>
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,7,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Début :"  Margin="15,5,5,5" VerticalAlignment="Center" Foreground="White" Width="50"/>
                            <DatePicker  x:Name="dtpDebutSearch" FontSize="12" VerticalAlignment="Center" Text=""  Width="100" IsEnabled="False" />
                            <TextBlock Text="Fin :"  Margin="10,5,5,5" VerticalAlignment="Center" Foreground="White" Width="25"  IsEnabled="False"/>
                            <DatePicker  x:Name="dtpFinSearch" FontSize="12" VerticalAlignment="Center" Text=""  Width="100" />
                            <!--TextBlock Text="Mot clé :"  Margin="10,5,5,5" VerticalAlignment="Center" Foreground="White" Width="50"/>
                            <TextBox   x:Name="TbxKeyword" FontSize="12" VerticalAlignment="Center" Text=""  Width="100" />
                            <Button x:Name="btnOK" Content="OK" Width="40" Margin="15,0,0,0"/-->
                            <Button x:Name="btnExportExcel" MinWidth="30" MinHeight="30" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="White" >
                                <Button.Background>
                                    <ImageBrush Stretch="Uniform" ImageSource="Logo_excel.png" />
                                </Button.Background>
                            </Button>
                            <Ellipse x:Name="lpsAction" Fill="Red" Height="20" Width="20" Stroke="White" StrokeThickness="2" Margin="5,0,0,0" Visibility="Hidden"/>
                        </StackPanel>
                        <Ellipse x:Name="elpsLoadin" Width="30" Height="30" Fill="Cyan" Visibility="Collapsed"/>
                    </StackPanel>

                </WrapPanel>
            </Grid>
            <TextBlock x:Name="tbkTotal" Text="Nombre total :0 " Foreground="White" Background="#FF000042" Margin="0" Padding="10,0,0,0" />
        </StackPanel>
        <ScrollViewer  Grid.Row="1"  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible">
            <DataGrid x:Name="dgPointGlobal" AutoGenerateColumns="True" AlternatingRowBackground="#FFCCFFEF"/>
        </ScrollViewer>
    </Grid>
</Window>
