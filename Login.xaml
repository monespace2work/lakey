<Window x:Class="Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lakey"
        mc:Ignorable="d"
        Title="Login" Height="150" Width="300" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Loaded="Window_Loaded" Icon="MyIco.ico" >
    <Grid Background="#FF061A51">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Width="100" Height="100" Source="Forms Pad/MyIco.png" Opacity="0.9"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="5,10">
            <Grid >
                <TextBox Name="txtUsername" Height="20"  Margin="0,0,0,10"/>
                <TextBlock x:Name="tblUsername"  Text="  User mane" Foreground="#FF7AA1A2" IsHitTestVisible="False"/>
            </Grid>
            <Grid >
                <PasswordBox Name="txtPassword" Height="20"   />
                <TextBlock x:Name="tblPassword"  Text=" Password" Foreground="#FF7AA1A2" IsHitTestVisible="False"/>
            </Grid>

            <Button x:Name="btnLogin" Content="Login" Margin="20,10,20,0"  IsDefault="True" IsEnabled="False" />
        </StackPanel>

    </Grid>
</Window>
