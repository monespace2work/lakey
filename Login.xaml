<Window x:Class="Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lakey"
        mc:Ignorable="d"
        Title="Login" Height="365" Width="470" MinHeight="365" MinWidth="470"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Loaded="Window_Loaded" Icon="MyIco.ico"
        Background="{DynamicResource ThemeSurfaceBrush}" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource ThemeSurfaceBrush}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource ThemeCardBrush}" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource ThemeHeaderBrush}" CornerRadius="11,0,0,11">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image Width="112" Height="112" Source="Forms Pad/MyIco.png" Stretch="Uniform" Margin="0,0,0,10"/>
                        <TextBlock Text="LAKEY" Foreground="White" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Gestion des équipes" Foreground="#D6E4F0" FontSize="11" Margin="0,2,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="24,20,24,18" VerticalAlignment="Center">
                    <TextBlock Text="Connexion" Foreground="{DynamicResource ThemeInkBrush}" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBlock Text="Connectez-vous à votre espace de gestion." Foreground="{DynamicResource ThemeInputPlaceholderBrush}" FontSize="12" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,10">
                        <TextBox Name="txtUsername" Height="38" Padding="11,6" VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="tblUsername" Text="Nom d'utilisateur" Foreground="#64748B" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <Grid>
                        <PasswordBox Name="txtPassword" Height="38" Padding="11,6" VerticalContentAlignment="Center"/>
                        <TextBlock x:Name="tblPassword" Text="Mot de passe" Foreground="#64748B" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <CheckBox x:Name="chkUseLocalMode" Content="Utiliser la base locale" Margin="0,9,0,0"
                              Foreground="{DynamicResource ThemeInkBrush}"/>

                    <Button x:Name="btnLogin" Content="Se connecter" Height="38" Margin="0,16,0,0"
                            IsDefault="True" IsEnabled="False"
                            Background="{DynamicResource ThemeLoginButtonBrush}" Foreground="{DynamicResource ThemeLoginButtonTextBrush}"
                            FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock Grid.Row="1" Text="Développé par Julio P. Bag"
                   Foreground="{DynamicResource ThemeInkBrush}" FontSize="11"
                   HorizontalAlignment="Right" Margin="0,5,4,0"/>
        <Grid x:Name="grdLoginLoading" Grid.RowSpan="2" Panel.ZIndex="1000"
              Background="#9900113E" Visibility="Collapsed" IsHitTestVisible="True">
            <Grid.Resources>
                <Storyboard x:Key="LoginLoadingRotationStoryboard">
                    <DoubleAnimation Storyboard.TargetName="LoginLoadingRotation"
                                     Storyboard.TargetProperty="Angle"
                                     From="0" To="360" Duration="0:0:0.8"
                                     RepeatBehavior="Forever"/>
                </Storyboard>
            </Grid.Resources>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="54" Height="54" Stroke="{DynamicResource ThemeAccentBrush}"
                         StrokeThickness="6" StrokeDashArray="2,2"
                         RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="LoginLoadingRotation"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock Text="Connexion en cours..."
                           Foreground="White" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
