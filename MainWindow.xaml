<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lakey"
        mc:Ignorable="d"
        Title="Lakey" Height="450" Width="800" MinHeight="300" MinWidth="500" WindowStartupLocation="CenterScreen" WindowState="Maximized" Loaded="Window_Loaded" KeyDown="Window_KeyDown" >
    <Grid>
        <Image x:Name="ImgBackground" Source="/Lakey;component/MyIco.png" Stretch="UniformToFill">
            <Image.Effect>
                <BlurEffect Radius="20"/>
            </Image.Effect>
        </Image>

        <!-- Couche semi-transparente pour améliorer la lisibilité -->
        <Rectangle Fill="#CC000000" />

        <Grid Background="#196B94A9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MaxWidth="200" MinWidth="100"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="8*" MaxHeight="20"/>
                <RowDefinition Height="15*" MinHeight="65" />
                <RowDefinition Height="80*"/>
                <RowDefinition Height="5*" MinHeight="50"/>
            </Grid.RowDefinitions>
            <Border x:Name="bdrEntete" Background="Azure" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3">
                <Menu >
                    <MenuItem x:Name="mitActions"  Header="Actions">
                        <MenuItem x:Name="mitActual"  Header="_Actualiser" InputGestureText="Ctrl+Shift+A" ></MenuItem>
                        <MenuItem x:Name="mitBackup"  Header="_BackUp" InputGestureText="Ctrl+Shift+U" ></MenuItem>
                        <MenuItem x:Name="mitDConexion"  Header="Déonne_xion" InputGestureText="Ctrl+Shift+X" ></MenuItem>
                        <MenuItem x:Name="mitQuit"  Header="_Quitter" InputGestureText="Ctrl+Shift+Q" ></MenuItem>
                    </MenuItem>
                    <MenuItem x:Name="mitMouvement"  Header="Mouvement">
                        <MenuItem x:Name="mitEntree" Header="Entrée"/>
                        <MenuItem x:Name="mitAffectation" Header="Affectation"/>
                        <MenuItem x:Name="mitSortie" Header="Sortie"/>
                        <!--MenuItem Header="Utilisateurs"/-->

                    </MenuItem>
                    <MenuItem x:Name="mitStructure"  Header="Structure">
                        <MenuItem x:Name="mitFonction" Header="Fonction"/>
                        <MenuItem x:Name="mitSociete" Header="Société"/>
                    </MenuItem>
                    <MenuItem x:Name="mitParametres"  Header="Paramètres">
                        <MenuItem x:Name="mitPgeneraux" Header="Globaux"/>
                        <MenuItem x:Name="mitUtilisateur"  Header="Utilisateurs"/>
                    </MenuItem>

                </Menu>
            </Border>
            <Border x:Name="bdrTitreGauche" Background="#CC557E94" Grid.Column="0" Grid.ColumnSpan="2"  Grid.Row="1" Margin="0" >
                <Grid Margin="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" MaxWidth="40"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="MyIco.png" Grid.Column="0">
                    </Image>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LAKEY" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                        <GradientStop Color="#FF1A008C" Offset="1"/>
                                        <GradientStop Color="#FFD7B60C"/>
                                        <GradientStop Color="#FFC1ECCB" Offset="0.203"/>
                                        <GradientStop Color="#FFFFC60A" Offset="0.904"/>
                                        <GradientStop Color="White" Offset="0.56"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock x:Name="tbxVersion" Text="version" Foreground="White" Margin="2,0,0,0" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" FontSize="10"/>
                        </StackPanel>
                        <TextBlock x:Name="tbxUserName" Text="UserName" Foreground="White" Margin="5,0,0,0" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="bdrTitreCentre"  Grid.Column="2" Grid.Row="1" VerticalAlignment="Bottom">
                <StackPanel >
                    <Border x:Name="bdrEnTete001" >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition MinWidth="90"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1"  Orientation="Horizontal" HorizontalAlignment="Right" MinHeight="35">
                                <TextBlock x:Name="tbkSteName" Text="Ma Socité" Margin="5,0" VerticalAlignment="Center" FontSize="16" TextDecorations="{x:Null}" Foreground="White" Background="#7F000000" Padding="5,0" TextWrapping="Wrap"/>
                                <Image x:Name="imgLoogo"  Source="MyIco.png" MaxHeight="30" MinHeight="20" Margin="0,0,5,0" />
                                <Image x:Name="imgHorsConnex"  Source="hors_connexion2.png" Width="25" Margin="0,0,5,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Background="#3300344F">
                        <Grid  >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="375*"/>
                                <ColumnDefinition Width="118*"/>
                                <ColumnDefinition Width="42*"/>
                            </Grid.ColumnDefinitions>
                            <Expander x:Name="xpdAgentRaccourcis"  Header="Agents &gt; Raccourcis"  Grid.Column="0" Foreground="#FFD2FFD8"  IsExpanded="True" Margin="0,0,0,5" VerticalAlignment="Top" Background="{x:Null}"  >
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="btnRacEntreeAg"  Content="Entrées" Height="20" Margin="5,0,1,0" Padding="3,1,6,1" Background="#FFD1FFD7"/>
                                    <Button x:Name="btnRacContratAg"  Content="Contrat" Height="20" Margin="5,0,1,0" Padding="3,1" Background="#FFD1FFD7"/>
                                    <Button x:Name="btnRacAffectationAg"  Content="Affectation" Height="20" Margin="5,0,1,0" Padding="3,1" Background="#FFD1FFD7"/>
                                    <Button x:Name="btnRacPlanningAg"  Content="Planning" Height="20" Margin="5,0,1,0" Padding="3,1" Background="#FFD1FFD7"/>
                                    <Button x:Name="btnRacAbsenceAg"  Content="Absence/Permission/Congé" Height="20" Margin="5,0,1,0" Padding="3,1" Background="#FFD1FFD7"/>
                                    <Button x:Name="btnRacHeureSupAg"  Content="HeuresSup" Height="20" Margin="5,0,1,0" Padding="3,1" Background="#FFD1FFD7"/>
                                    <Button x:Name="btnRacCalCong" Content="Point - Congés" Height="20" Margin="5,0,1,0" Padding="3,1" Background="#FF557E94" BorderBrush="White" BorderThickness="2" Foreground="White"/>
                                    <Button x:Name="btnRacSortieAg"  Content="Sortie" Height="20" Margin="5,0,1,0" Padding="3,1" Background="#FFD1FFD7"/>
                                </WrapPanel>
                            </Expander>
                            <Expander x:Name="xpdClientRaccourcis" Header="Client  &gt; Raccourcis" Grid.Column="1" HorizontalAlignment="Right"  Foreground="#FFD2FFD8"  IsExpanded="True" Grid.ColumnSpan="2" Margin="0,0,0,5" VerticalAlignment="Top" Background="{x:Null}"  >
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="btnRacContratCl" Content="Contrat" Height="20" Margin="5,0,1,0" Padding="3,1,6,1" Background="#FF00113E" BorderBrush="White" Foreground="White"/>
                                    <Button x:Name="btnRacSiteCl"  Content="Sites" Height="20" Margin="5,0,1,0" Padding="3,1" Background="#FF00113E" BorderBrush="White" Foreground="White"/>
                                    <Button x:Name="btnRacPosteCl" Content="Postes" Height="20" Margin="5,0,1,0" Padding="3,1" Background="#FF00113E" BorderBrush="White" Foreground="White"/>
                                    <Button x:Name="btnRacEtatCl"  Content="Etat" Height="20" Margin="5,0,1,0" Padding="3,1,6,1" Background="#FF00113E" BorderBrush="White" Foreground="White"/>
                                    <Button x:Name="btnRacAgentListeCl"  Content="Agents affect." Height="20" Margin="5,0,1,0" Padding="3,1,6,1" Background="#FF00113E" BorderBrush="White" Foreground="White"/>
                                </WrapPanel>
                            </Expander>

                        </Grid>
                    </Border>
                </StackPanel>
            </Border>


            <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="0" Grid.Row="2">
                <Border x:Name="bdrColonneGauche" Background="#FF557E94"  >
                    <StackPanel>
                        <Button x:Name="btnTBord" Content="Tableau de bord" Height="30" FontSize="14" FontWeight="ExtraBold" Foreground="#FF0C2C3C"  Background="#FFDDDDDD" Style="{StaticResource  btnStandars}" Click="btnTBord_Click"/>
                        <Button x:Name="btnAgents"  Content="Agents" Style="{StaticResource  btnStandars}" Click="btnAgents_Click" Background="#FFDDDDDD" Height="30" FontSize="14" FontWeight="Bold"/>
                        <Button x:Name="btnTraitement"  Content="Traitements"  Style="{StaticResource  btnStandars}" Click="btnTraitement_Click"  Height="30" FontWeight="Bold" FontSize="14"/>
                        <Button x:Name="btnClient"  Content="Clients" Style="{StaticResource  btnStandars}" Click="btnClient_Click"  Height="30" FontSize="14" FontWeight="Bold"/>

                        <!--Separator Margin="20,5"/-->
                        <Expander x:Name="xpdPlusOp" Header="PLUS D'OPTIONS" Foreground="White">
                            <StackPanel>
                                <Button x:Name="btnSupplement"  Content="Suppléments" Click="Button_Click" Style="{StaticResource  btnStandars}"  Height="30" FontSize="14" FontWeight="Bold"/>
                                <Button x:Name="btnStructure" Content="Structure" Style="{StaticResource  btnStandars}" Click="btnStructure_Click"  Height="30" FontWeight="Bold" FontSize="14"/>
                                <Button x:Name="btnSeting"  Content="Settings" Style="{StaticResource btnStandars}" Height="30" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                        </Expander>
                        <StackPanel Margin="10">
                            <TextBlock x:Name="tbkTtiteBloc02" Text="Données de base"  Foreground="White" FontSize="14" FontWeight="Bold"/>
                            <StackPanel>
                                <TextBox x:Name="tbxAgentStat" Text="Agent"  Margin="3,0,0,2" Foreground="#FF7FFFF3"  Background="#FF225353" IsReadOnly="True" TextWrapping="WrapWithOverflow" />
                            </StackPanel>

                            <StackPanel Margin="0,1,0,0">
                                <TextBox x:Name="tbxClientStat" Text="Client"  Margin="3,0,0,2" Foreground="#FF7FFFF3" Background="#FF222953" IsReadOnly="True" TextWrapping="WrapWithOverflow" />
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </Border>
            </ScrollViewer>

            <Border  Grid.Column="2" Grid.Row="2" >
                <!--TextBlock x:Name="tblTitrCentral" Text="TITRE CENTRAL" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontFamily="Lucida Bright" FontWeight="Bold" /-->
                <ScrollViewer x:Name="bdrColonneCentre" Background="#996B94A9" VerticalScrollBarVisibility="Auto" >
                    <StackPanel>
                        <Ellipse x:Name="elpsLoadingCentral" Width="10" Height="10" Fill="Orange" Visibility="Collapsed"/>
                        <ContentControl x:Name="cctrlCentral" Background="Black"/>
                    </StackPanel>
                </ScrollViewer>

            </Border>
            <Border x:Name="bdrColonneDroit" Background="#7CC0E9FF" Grid.Column="1" Grid.Row="2" >
                <StackPanel>
                    <Ellipse x:Name="elpsLoading" Width="10" Height="10" Fill="Orange" Visibility="Collapsed"/>
                    <Button x:Name="btnRefresh" Content="ACTUALISER" Background="#FFB6FFC0" Margin="10,5,10,7"/>
                    <Separator/>
                    <Button x:Name="btnCalCong" Visibility="Collapsed" Content="Point - Congés" Style="{StaticResource btnSousStand}" Background="#FF557E94" BorderBrush="White" BorderThickness="2" Foreground="White" Margin="10,3"/>
                    <StackPanel x:Name="stpTBord" />
                    <StackPanel x:Name="stpEmployes">
                        <Button x:Name="btnEntree" Content="Embauche/Entrée" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnContrat" Content="Contrat" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnAffectation" Content="Affectation" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnPlanning" Content="Planning" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnSortie" Content="Sorties" Style="{StaticResource btnSousStand}"/>
                    </StackPanel>
                    <StackPanel x:Name="stpTraitement">
                        <Button  x:Name="btnAbsence" Content="Absences" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnHeureSupp" Content="Heure Suppl." Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnConges" Content="Congés" Style="{StaticResource btnSousStand}" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel x:Name="stpClient">
                        <Button  x:Name="btnClientContrat" Content="Contrat Clients" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnSite" Content="Site" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnPoste" Content="Poste" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnClientEtat" Content="Etat" Style="{StaticResource btnSousStand}"/>
                    </StackPanel>
                    <StackPanel x:Name="stpSupplement">
                        <Button  x:Name="btnRappel" Content="Rappel" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnMemo" Content="Memo/Note" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnEvenement" Content="Evénements" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnCompta" Content="Compta" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnCnss" Content="CNSS" Style="{StaticResource btnSousStand}"/>

                    </StackPanel>
                    <StackPanel x:Name="stpStructure">
                        <Button x:Name="btnFonction" Content="Fonction" Style="{StaticResource btnSousStand}" />
                        <Button x:Name="btnSociety" Content="Société" Style="{StaticResource btnSousStand}"/>
                        <Button x:Name="btnAgency" Content="Agences" Style="{StaticResource btnSousStand}" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel x:Name="stpSetting" >
                        <Button  x:Name="btnGeneral" Content="Global Settings" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnUser" Content="Ulilisateur" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnProfilUser" Content="Profil Ulilisateur" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnDataSets" Content="Données de base" Style="{StaticResource btnSousStand}" Visibility="Collapsed"/>

                    </StackPanel>
                    <Expander  x:Name="wrpRappel" Background="#FFA40000" Header="RAPPELS IMPORTANTS" MinHeight="5" MaxHeight="200" IsExpanded="True" Foreground="White" FontWeight="Bold" >
                        <TextBox x:Name="tbxRappel" Background="#FFFFB8B8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontWeight="Normal" />
                    </Expander>

                </StackPanel>
            </Border>
            <Border x:Name="brdT11" Grid.Column="0"  Opacity="0.9" >
                <StackPanel Margin="10">
                    <TextBlock x:Name="tbkTtiteBloc01" Text="Données de base"  Foreground="White" FontSize="18" FontWeight="Bold"/>
                </StackPanel>
            </Border>


            <Border x:Name="bdrBasPage" Background="Azure" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="DarkCyan">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MaxWidth="80"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label x:Name="lblAgentSearch" Content="Agents" FontSize="10" Margin="1,0,0,1" Foreground="White"/>
                                <TextBox x:Name="BtnAgentSearch" Height="28" Style="{StaticResource SearchButtonRounded}" />
                            </StackPanel>
                            <DataGrid x:Name="dgAgent" Grid.Column="1" AutoGenerateColumns="True" Background="#FF0F9B9B" HeadersVisibility="None" RowBackground="#FF88F4FF">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Resumé" Name="cmiResume" />
                                        <MenuItem Header="Contrat" Name="cmiContrat" />
                                        <MenuItem Header="Affectation" Name="cmiAffectation"/>
                                        <MenuItem Header="Absences/Permissions" Name="cmiAbsence"/>
                                        <MenuItem Header="Heures supplémentaire" Name="cmiHeureSup"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="Aquamarine">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MaxWidth="80"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label x:Name="lblContratSearch"  Content="Contrats" FontSize="10" Margin="1,0,0,1" Foreground="#FF000106"/>
                                <TextBox x:Name="BtnContratSearch" Height="28" Style="{StaticResource SearchButtonRounded}" />
                            </StackPanel>
                            <DataGrid  x:Name="dgContrat" Grid.Column="1" AutoGenerateColumns="True" Background="#FF62DEB5" HeadersVisibility="None" RowBackground="#FFABFFE3">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Résumé" Name="cmiResumeC" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                            </DataGrid>
                        </Grid>

                    </Border>
                    <Border Grid.Column="0" Background="#FF7FFFF3">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MaxWidth="80"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label x:Name="lblPlanningSearch" Content="En poste" FontSize="10" Margin="1,0,0,1" Foreground="#FF00165A" Background="{x:Null}"/>
                                <TextBox x:Name="BtnPlanningSearch" Height="28" Style="{StaticResource SearchButtonRounded}" />
                            </StackPanel>
                            <DataGrid  x:Name="dgPlanning" Grid.Column="1" AutoGenerateColumns="True" HeadersVisibility="None" RowBackground="#FFA5FFF7" Background="#FF7FFFF3">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Cette semaine" Name="cmiThisW" />
                                        <MenuItem Header="Semaine prochaine" Name="cmiNextW" />
                                        <MenuItem Header="A ce poste " Name="cmiPostePlanning" >
                                            <MenuItem Header="Cette semaine" Name="cmiThisWp" />
                                            <MenuItem Header="Semaine prochaine" Name="cmiNextWp" />
                                        </MenuItem>

                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                            </DataGrid>
                        </Grid>

                    </Border>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
