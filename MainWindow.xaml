<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lakey"
        mc:Ignorable="d"
        Title="Lakey" Height="850" Width="1440" MinHeight="620" MinWidth="980" WindowStartupLocation="CenterScreen" WindowState="Maximized" Loaded="Window_Loaded" KeyDown="Window_KeyDown" Background="{DynamicResource ThemeSurfaceBrush}" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeInkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeSurfaceBrush}"/>
            <Setter Property="MinHeight" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeAccentSoftBrush}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.78"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuickAccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="2,2"/>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.82"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AgentQuickAccessButton" TargetType="Button" BasedOn="{StaticResource QuickAccessButton}">
            <Setter Property="Background" Value="{DynamicResource ThemeAgentButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeAgentButtonTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeAgentHoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeAgentButtonTextBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource ThemeAgentSelectedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeAgentSelectedTextBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClientQuickAccessButton" TargetType="Button" BasedOn="{StaticResource QuickAccessButton}">
            <Setter Property="Background" Value="{DynamicResource ThemeClientButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeClientButtonTextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeClientHoverBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeClientButtonTextBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource ThemeClientSelectedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeClientSelectedTextBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CongesQuickAccessButton" TargetType="Button" BasedOn="{StaticResource QuickAccessButton}">
            <Setter Property="Background" Value="{DynamicResource ThemeCongesButtonBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeCongesButtonTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCongesSelectedBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeCongesHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource ThemeCongesSelectedBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeCongesSelectedTextBrush}"/>
                    <Setter Property="Opacity" Value="1"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,5"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource ThemeCardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeInputTextBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource ThemeTextSelectionBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource ThemeInputDisabledBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeInputDisabledTextBrush}"/>
                </Trigger>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ThemeInputDisabledBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource ThemeInputDisabledTextBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid Background="{DynamicResource ThemeSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" MinWidth="165" MaxWidth="230"/>
                <ColumnDefinition Width="245" MinWidth="210" MaxWidth="300"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="34"/>
                <RowDefinition Height="Auto" MinHeight="112"/>
                <RowDefinition Height="*" MinHeight="250"/>
                <RowDefinition Height="88" MinHeight="82" MaxHeight="115"/>
            </Grid.RowDefinitions>
            <Border x:Name="bdrEntete" Background="{DynamicResource ThemeCardBrush}" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0">
                <Menu >
                    <MenuItem x:Name="mitActions"  Header="Actions">
                        <MenuItem x:Name="mitActual"  Header="_Actualiser" InputGestureText="Ctrl+Shift+A" ></MenuItem>
                        <MenuItem x:Name="mitBackup"  Header="_BackUp" InputGestureText="Ctrl+Shift+U" ></MenuItem>
                        <MenuItem x:Name="mitDConexion"  Header="Déonne_xion" InputGestureText="Ctrl+Shift+X" ></MenuItem>
                        <MenuItem x:Name="mitQuit"  Header="_Quitter" InputGestureText="Ctrl+Shift+Q" ></MenuItem>
                    </MenuItem>
                    <MenuItem x:Name="mitMouvement"  Header="Mouvement">
                        <MenuItem x:Name="mitEntree" Header="Entrée"/>
                        <MenuItem x:Name="mitAffectation" Header="Affectation"/>
                        <MenuItem x:Name="mitSortie" Header="Sortie"/>
                        <!--MenuItem Header="Utilisateurs"/-->

                    </MenuItem>
                    <MenuItem x:Name="mitStructure"  Header="Structure">
                        <MenuItem x:Name="mitFonction" Header="Fonction"/>
                        <MenuItem x:Name="mitSociete" Header="Société"/>
                    </MenuItem>
                    <MenuItem x:Name="mitParametres"  Header="Paramètres">
                        <MenuItem x:Name="mitPgeneraux" Header="Globaux"/>
                        <MenuItem x:Name="mitUtilisateur"  Header="Utilisateurs"/>
                    </MenuItem>
                    <MenuItem x:Name="mitAide" Header="Aide">
                        <MenuItem x:Name="mitContact" Header="Contact" Click="mitContact_Click"/>
                        <MenuItem x:Name="mitAideUtilisation" Header="Guide d'utilisation" Click="mitAideUtilisation_Click"/>
                        <Separator/>
                        <MenuItem x:Name="mitAPropos" Header="À propos de LAKEY" Click="mitAPropos_Click"/>
                    </MenuItem>
                </Menu>
            </Border>
            <Border x:Name="bdrTitreGauche" Background="{DynamicResource ThemeHeaderBrush}" Grid.Column="0" Grid.Row="1" Margin="0" Padding="10,8" CornerRadius="0">
                <Grid Margin="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" MaxWidth="40"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="MyIco.png" Grid.Column="0">
                    </Image>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LAKEY" FontWeight="Bold" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBlock x:Name="tbxVersion" Text="version" Foreground="White" Margin="2,0,0,0" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" FontSize="10"/>
                        </StackPanel>
                        <TextBlock x:Name="tbxUserName" Text="UserName" Foreground="White" Margin="5,0,0,0" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="bdrTitreCentre" Background="{DynamicResource ThemeHeaderBrush}" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Stretch" Padding="8,6" CornerRadius="0">
                <StackPanel >
                    <Border x:Name="bdrEnTete001" >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition MinWidth="90"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1"  Orientation="Horizontal" HorizontalAlignment="Right" MinHeight="35">
                                <TextBlock x:Name="tbkSteName" Text="Ma Socité" Margin="5,0" VerticalAlignment="Center" FontSize="16" TextDecorations="{x:Null}" Foreground="{DynamicResource ThemeHeaderTextBrush}" Background="#7F000000" Padding="5,0" TextWrapping="Wrap"/>
                                <Button x:Name="btnThemeToggle" Content="Mode clair" Click="btnThemeToggle_Click"
                                        Margin="5,0" Padding="9,4" MinHeight="28" VerticalAlignment="Center"
                                        Background="{DynamicResource ThemeAccentBrush}" Foreground="{DynamicResource ThemeNavyBrush}"
                                        FontWeight="SemiBold" ToolTip="Basculer entre le mode clair et le mode sombre"/>
                                <TextBlock x:Name="tbModeConnexion" Text="MODE LOCAL" Visibility="Collapsed"
                                           Margin="5,0" Padding="7,4" VerticalAlignment="Center"
                                           Background="#FFFFD166" Foreground="#FF5B2100" FontWeight="Bold"
                                           ToolTip="La base locale est utilisée ; les modifications ne sont pas synchronisées automatiquement"/>
                                <Button x:Name="btnReconnecter" Content="Retenter la connexion" Visibility="Collapsed"
                                        Margin="5,0" Padding="8,4" VerticalAlignment="Center"
                                        Click="btnReconnecter_Click"
                                        ToolTip="Tester le mode connecté ; une confirmation et une sauvegarde précéderont toute actualisation"/>
                                <Image x:Name="imgLoogo"  Source="MyIco.png" MaxHeight="30" MinHeight="20" Margin="0,0,5,0" />
                                <Image x:Name="imgHorsConnex"  Source="hors_connexion2.png" Width="25" Margin="0,0,5,0"
                                       ToolTip="Mode local : les modifications ne sont pas synchronisées automatiquement"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource ThemeNavyBrush}" CornerRadius="5" Padding="4">
                        <Grid  >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2.2*" MaxWidth="400"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0,0,4,0" Padding="6,3"
                                    Background="{DynamicResource ThemeAgentGroupBrush}"
                                    BorderBrush="{DynamicResource ThemeAgentGroupBorderBrush}" BorderThickness="1" CornerRadius="5">
                                <Expander x:Name="xpdAgentRaccourcis" Header="Agents &gt; Raccourcis"
                                          Foreground="{DynamicResource ThemeAgentGroupLabelBrush}"
                                          IsExpanded="True" VerticalAlignment="Top" Background="{x:Null}"
                                          FontSize="13" FontWeight="Bold" Padding="2,2">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="btnRacEntreeAg" Content="Entrées" Style="{StaticResource AgentQuickAccessButton}"/>
                                            <Button x:Name="btnRacContratAg" Content="Contrat" Style="{StaticResource AgentQuickAccessButton}"/>
                                            <Button x:Name="btnRacAffectationAg" Content="Affectation" Style="{StaticResource AgentQuickAccessButton}"/>
                                            <Button x:Name="btnRacPlanningAg" Content="Planning" Style="{StaticResource AgentQuickAccessButton}"/>
                                            <Button x:Name="btnRacAbsenceAg" Content="Absence/Permission/Congé" Style="{StaticResource AgentQuickAccessButton}"/>
                                            <Button x:Name="btnRacHeureSupAg" Content="HeuresSup" Style="{StaticResource AgentQuickAccessButton}"/>
                                            <Button x:Name="btnRacCalCong" Content="Point - Congés" Style="{StaticResource CongesQuickAccessButton}"/>
                                            <Button x:Name="btnRacSortieAg" Content="Sortie" Style="{StaticResource AgentQuickAccessButton}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Expander>
                            </Border>
                            <Border Grid.Column="1" Margin="4,0,0,0" Padding="6,3"
                                    Background="{DynamicResource ThemeClientGroupBrush}"
                                    BorderBrush="{DynamicResource ThemeClientGroupBorderBrush}" BorderThickness="1" CornerRadius="5">
                                <Expander x:Name="xpdClientRaccourcis" Header="Client &gt; Raccourcis"
                                          HorizontalAlignment="Stretch"
                                          Foreground="{DynamicResource ThemeClientGroupLabelBrush}"
                                          IsExpanded="True" VerticalAlignment="Top" Background="{x:Null}"
                                          FontSize="13" FontWeight="Bold" Padding="2,2">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="btnRacContratCl" Content="Contrat" Style="{StaticResource ClientQuickAccessButton}"/>
                                            <Button x:Name="btnRacSiteCl" Content="Sites" Style="{StaticResource ClientQuickAccessButton}"/>
                                            <Button x:Name="btnRacPosteCl" Content="Postes" Style="{StaticResource ClientQuickAccessButton}"/>
                                            <Button x:Name="btnRacEtatCl" Content="Etat" Style="{StaticResource ClientQuickAccessButton}"/>
                                            <Button x:Name="btnRacAgentListeCl" Content="Agents affect." Style="{StaticResource ClientQuickAccessButton}"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Expander>
                            </Border>

                        </Grid>
                    </Border>
                </StackPanel>
            </Border>


            <Grid x:Name="grdBody" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="colLeftPanel" Width="190" MinWidth="165" MaxWidth="230"/>
                    <ColumnDefinition x:Name="colRightPanel" Width="245" MinWidth="210" MaxWidth="300"/>
                    <ColumnDefinition Width="*" MinWidth="420"/>
                </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Column="0">
                <Border x:Name="bdrColonneGauche" Background="{DynamicResource ThemeHeaderBrush}" Padding="8,10" BorderBrush="{DynamicResource ThemeNavyBrush}" BorderThickness="0,0,1,0" CornerRadius="0">
                    <StackPanel>
                        <Button x:Name="btnToggleLeftPanel"
                                Content="◀"
                                ToolTip="Réduire le panneau"
                                Width="30"
                                Height="30"
                                MinHeight="30"
                                Padding="0"
                                HorizontalAlignment="Right"
                                Click="btnToggleLeftPanel_Click"/>
                        <TextBlock x:Name="tbkLeftPanelCollapsedTitle"
                                   Text="Principales options + Stats"
                                   Width="280"
                                   Height="28"
                                   Margin="0,10,0,0"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Visibility="Collapsed">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                        <StackPanel x:Name="stpLeftPanelContent">
                        <Button x:Name="btnTBord" Content="Tableau de bord" Height="30" FontSize="14" FontWeight="ExtraBold" Foreground="{DynamicResource ThemeNavyBrush}"  Background="{DynamicResource ThemeCardBrush}" Style="{StaticResource  btnStandars}" Click="btnTBord_Click"/>
                        <Button x:Name="btnAgents"  Content="Agents" Style="{StaticResource  btnStandars}" Click="btnAgents_Click" Background="{DynamicResource ThemeCardBrush}" Height="30" FontSize="14" FontWeight="Bold"/>
                        <Button x:Name="btnTraitement"  Content="Traitements"  Style="{StaticResource  btnStandars}" Click="btnTraitement_Click"  Height="30" FontWeight="Bold" FontSize="14"/>
                        <Button x:Name="btnClient"  Content="Clients" Style="{StaticResource  btnStandars}" Click="btnClient_Click"  Height="30" FontSize="14" FontWeight="Bold"/>

                        <!--Separator Margin="20,5"/-->
                        <Expander x:Name="xpdPlusOp" Header="PLUS D'OPTIONS" Foreground="White">
                            <StackPanel>
                                <Button x:Name="btnSupplement"  Content="Suppléments" Click="Button_Click" Style="{StaticResource  btnStandars}"  Height="30" FontSize="14" FontWeight="Bold"/>
                                <Button x:Name="btnStructure" Content="Structure" Style="{StaticResource  btnStandars}" Click="btnStructure_Click"  Height="30" FontWeight="Bold" FontSize="14"/>
                                <Button x:Name="btnSeting"  Content="Settings" Style="{StaticResource btnStandars}" Height="30" FontWeight="Bold" FontSize="14"/>
                            </StackPanel>
                        </Expander>
                        <StackPanel Margin="10">
                            <TextBlock x:Name="tbkTtiteBloc02" Text="Données de base"  Foreground="White" FontSize="14" FontWeight="Bold"/>
                            <StackPanel>
                                <TextBox x:Name="tbxAgentStat" Text="Agent"  Margin="3,0,0,2" Foreground="#FF7FFFF3"  Background="#FF225353" IsReadOnly="True" TextWrapping="WrapWithOverflow" />
                            </StackPanel>

                            <StackPanel Margin="0,1,0,0">
                                <TextBox x:Name="tbxClientStat" Text="Client"  Margin="3,0,0,2" Foreground="#FF7FFFF3" Background="#FF222953" IsReadOnly="True" TextWrapping="WrapWithOverflow" />
                            </StackPanel>

                        </StackPanel>

                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <Border Grid.Column="2">
                <!--TextBlock x:Name="tblTitrCentral" Text="TITRE CENTRAL" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontFamily="Lucida Bright" FontWeight="Bold" /-->
                <ScrollViewer x:Name="bdrColonneCentre" Background="{DynamicResource ThemeContentSurfaceBrush}" VerticalScrollBarVisibility="Auto" Padding="12" PreviewMouseWheel="bdrColonneCentre_PreviewMouseWheel">
                    <StackPanel>
                        <Ellipse x:Name="elpsLoadingCentral" Width="10" Height="10" Fill="Orange" Visibility="Collapsed"/>
                        <ContentControl x:Name="cctrlCentral" Background="Transparent"/>
                    </StackPanel>
                </ScrollViewer>

            </Border>
            <Border x:Name="bdrColonneDroit" Background="{DynamicResource ThemeCardBrush}" Grid.Column="1" Padding="10" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1,0,1,0" CornerRadius="0">
                <StackPanel>
                    <Button x:Name="btnToggleRightPanel"
                            Content="◀"
                            ToolTip="Réduire le panneau"
                            Width="30"
                            Height="30"
                            MinHeight="30"
                            Padding="0"
                            HorizontalAlignment="Right"
                            Click="btnToggleRightPanel_Click"/>
                    <TextBlock x:Name="tbkRightPanelCollapsedTitle"
                               Text="Détails/Autres"
                               Width="180"
                               Height="28"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource ThemeInkBrush}"
                               FontSize="14"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Visibility="Collapsed">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="90"/>
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                    <StackPanel x:Name="stpRightPanelContent">
                    <Ellipse x:Name="elpsLoading" Width="10" Height="10" Fill="Orange" Visibility="Collapsed"/>
                    <Button x:Name="btnRefresh" Content="ACTUALISER" Background="{DynamicResource ThemeAccentBrush}" Foreground="{DynamicResource ThemeNavyBrush}" Margin="10,5,10,7"/>
                    <Separator/>
                    <Button x:Name="btnCalCong" Visibility="Collapsed" Content="Point - Congés" Style="{StaticResource btnSousStand}" Background="#FF557E94" BorderBrush="White" BorderThickness="2" Foreground="White" Margin="10,3"/>
                    <StackPanel x:Name="stpTBord" />
                    <StackPanel x:Name="stpEmployes">
                        <Button x:Name="btnEntree" Content="Embauche/Entrée" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnContrat" Content="Contrat" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnAffectation" Content="Affectation" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnPlanning" Content="Planning" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnSortie" Content="Sorties" Style="{StaticResource btnSousStand}"/>
                    </StackPanel>
                    <StackPanel x:Name="stpTraitement">
                        <Button  x:Name="btnAbsence" Content="Absences" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnHeureSupp" Content="Heure Suppl." Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnConges" Content="Congés" Style="{StaticResource btnSousStand}" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel x:Name="stpClient">
                        <Button  x:Name="btnClientContrat" Content="Contrat Clients" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnSite" Content="Site" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnPoste" Content="Poste" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnClientEtat" Content="Etat" Style="{StaticResource btnSousStand}"/>
                    </StackPanel>
                    <StackPanel x:Name="stpSupplement">
                        <Button  x:Name="btnRappel" Content="Rappel" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnMemo" Content="Memo/Note" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnEvenement" Content="Evénements" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnCompta" Content="Compta" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnCnss" Content="CNSS" Style="{StaticResource btnSousStand}"/>

                    </StackPanel>
                    <StackPanel x:Name="stpStructure">
                        <Button x:Name="btnFonction" Content="Fonction" Style="{StaticResource btnSousStand}" />
                        <Button x:Name="btnSociety" Content="Société" Style="{StaticResource btnSousStand}"/>
                        <Button x:Name="btnAgency" Content="Agences" Style="{StaticResource btnSousStand}" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel x:Name="stpSetting" >
                        <Button  x:Name="btnGeneral" Content="Global Settings" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnUser" Content="Ulilisateur" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnProfilUser" Content="Profil Ulilisateur" Style="{StaticResource btnSousStand}"/>
                        <Button  x:Name="btnDataSets" Content="Données de base" Style="{StaticResource btnSousStand}" Visibility="Collapsed"/>

                    </StackPanel>
                    <Expander x:Name="wrpRappel"
                              Background="{DynamicResource ThemeReminderHeaderBrush}"
                              Header="RAPPELS IMPORTANTS"
                              MinHeight="5"
                              MaxHeight="200"
                              IsExpanded="True"
                              Foreground="{DynamicResource ThemeReminderHeaderTextBrush}"
                              BorderBrush="{DynamicResource ThemeReminderBorderBrush}"
                              FontWeight="Bold">
                        <TextBox x:Name="tbxRappel"
                                 Background="{DynamicResource ThemeReminderSurfaceBrush}"
                                 Foreground="{DynamicResource ThemeReminderTextBrush}"
                                 BorderBrush="{DynamicResource ThemeReminderBorderBrush}"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontWeight="Normal" />
                    </Expander>

                    </StackPanel>
                </StackPanel>
            </Border>
            </Grid>
            <Border x:Name="bdrBasPage" Background="{DynamicResource ThemeNavyBrush}" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="3" BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="0,1,0,0" Padding="6" CornerRadius="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Background="{DynamicResource ThemeSearchAgentBrush}" BorderBrush="{DynamicResource ThemeSearchLabelBrush}" BorderThickness="1" Padding="3" Margin="3" CornerRadius="5">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MaxWidth="80"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label x:Name="lblAgentSearch" Content="Agents" FontSize="12" FontWeight="Bold" Margin="1,0,0,2" Padding="4,1" Background="{DynamicResource ThemeSearchTitleBrush}" Foreground="{DynamicResource ThemeSearchLabelBrush}"/>
                                <TextBox x:Name="BtnAgentSearch" Height="34" Margin="1" Style="{StaticResource SearchButtonRounded}" />
                            </StackPanel>
                            <DataGrid x:Name="dgAgent" Grid.Column="1" AutoGenerateColumns="True" Background="{DynamicResource ThemeCardBrush}" HeadersVisibility="None" RowBackground="{DynamicResource ThemeAlternateRowBrush}">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Resumé" Name="cmiResume" />
                                        <MenuItem Header="Contrat" Name="cmiContrat" />
                                        <MenuItem Header="Affectation" Name="cmiAffectation"/>
                                        <MenuItem Header="Absences/Permissions" Name="cmiAbsence"/>
                                        <MenuItem Header="Heures supplémentaire" Name="cmiHeureSup"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource ThemeSearchContractBrush}" BorderBrush="{DynamicResource ThemeSearchLabelBrush}" BorderThickness="1" Padding="3" Margin="3" CornerRadius="5">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MaxWidth="80"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label x:Name="lblContratSearch"  Content="Contrats" FontSize="12" FontWeight="Bold" Margin="1,0,0,2" Padding="4,1" Background="{DynamicResource ThemeSearchTitleBrush}" Foreground="{DynamicResource ThemeSearchLabelBrush}"/>
                                <TextBox x:Name="BtnContratSearch" Height="34" Margin="1" Style="{StaticResource SearchButtonRounded}" />
                            </StackPanel>
                            <DataGrid  x:Name="dgContrat" Grid.Column="1" AutoGenerateColumns="True" Background="{DynamicResource ThemeCardBrush}" HeadersVisibility="None" RowBackground="{DynamicResource ThemeAlternateRowBrush}">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Résumé" Name="cmiResumeC" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                            </DataGrid>
                        </Grid>

                    </Border>
                    <Border Grid.Column="0" Background="{DynamicResource ThemeSearchPlanningBrush}" BorderBrush="{DynamicResource ThemeSearchLabelBrush}" BorderThickness="1" Padding="3" Margin="3" CornerRadius="5">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MaxWidth="80"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label x:Name="lblPlanningSearch" Content="En poste" FontSize="12" FontWeight="Bold" Margin="1,0,0,2" Padding="4,1" Foreground="{DynamicResource ThemeSearchLabelBrush}" Background="{DynamicResource ThemeSearchTitleBrush}"/>
                                <TextBox x:Name="BtnPlanningSearch" Height="34" Margin="1" Style="{StaticResource SearchButtonRounded}" />
                            </StackPanel>
                            <DataGrid  x:Name="dgPlanning" Grid.Column="1" AutoGenerateColumns="True" HeadersVisibility="None" RowBackground="{DynamicResource ThemeAlternateRowBrush}" Background="{DynamicResource ThemeCardBrush}">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Cette semaine" Name="cmiThisW" />
                                        <MenuItem Header="Semaine prochaine" Name="cmiNextW" />
                                        <MenuItem Header="A ce poste " Name="cmiPostePlanning" >
                                            <MenuItem Header="Cette semaine" Name="cmiThisWp" />
                                            <MenuItem Header="Semaine prochaine" Name="cmiNextWp" />
                                        </MenuItem>

                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                            </DataGrid>
                        </Grid>

                    </Border>

                </Grid>
            </Border>
            <Grid x:Name="grdLoadingOverlay" Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Grid.ColumnSpan="3" Panel.ZIndex="1000"
                  Background="#9900113E" Visibility="Collapsed" IsHitTestVisible="True">
                <Grid.Resources>
                    <Storyboard x:Key="LoadingRotationStoryboard">
                        <DoubleAnimation Storyboard.TargetName="LoadingRotation"
                                         Storyboard.TargetProperty="Angle"
                                         From="0" To="360" Duration="0:0:0.8"
                                         RepeatBehavior="Forever"/>
                    </Storyboard>
                </Grid.Resources>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Width="54" Height="54" Stroke="{DynamicResource ThemeAccentBrush}"
                             StrokeThickness="6" StrokeDashArray="2,2"
                             RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="LoadingRotation"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <TextBlock x:Name="tbkLoadingMessage" Text="Chargement des données..."
                               Foreground="White" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
