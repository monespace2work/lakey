<UserControl x:Class="usercStructure"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lakey"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid Background="#33010221" >
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="0"  Style="{StaticResource SectionHeaderBorder}">
            <Label Content="STRUCTURE" Foreground="White" HorizontalContentAlignment="Center" FontSize="20"/>

        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel >
                <StackPanel Margin="10,0,0,0" >
                    <TextBlock Text="Npre par VILLES" FontSize="14"/>
                    <DataGrid x:Name="DgStructure" AutoGenerateColumns="True" Background="#7FFFFFFF" />
                </StackPanel>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="FONCTIONS" FontSize="14"/>
                    <DataGrid x:Name="DgFonction" AutoGenerateColumns="True" Background="#7FFFFFFF" />
                </StackPanel>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="Nbre par FONCTION" FontSize="14"/>
                    <DataGrid x:Name="DgFonctionNbre" AutoGenerateColumns="True" Background="#7FFFFFFF" />
                </StackPanel>
                <!--DataGrid x:Name="DgStructure" AutoGenerateColumns="True" Background="#7FFFFFFF" /-->
            </WrapPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
