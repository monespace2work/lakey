<UserControl x:Class="usercNBanque"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lakey"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="0" Style="{StaticResource SectionHeaderBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MaxWidth="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition MaxWidth="200"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Grid.Column="0" HorizontalAlignment="Center">
                    <Label Content="OUTILS SUPPLLEMENTAIRES /" Foreground="White" HorizontalContentAlignment="Center" FontSize="15" />
                    <Label Content="BANQUE INFOS" Foreground="#FF99FF53"  FontSize="20" HorizontalContentAlignment="Center" FontWeight="Bold" />
                </StackPanel>                    
                <TextBox x:Name="BtnAgentListeSearch" Width="150" Height="28" Style="{StaticResource SearchButtonRounded}" Grid.Column="2"/>

            </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <Border BorderBrush="Black" BorderThickness="1" Background="#FF00170C">
                <StackPanel>
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Ellipse x:Name="elpStatus" Fill="Red" Width="10" Height=" 10" Visibility="Collapsed" />
                            <TextBlock x:Name="tblNbBanque" Text=" Nombre d'agents actif: "  Background="#FF00170C" Foreground="LightSkyBlue" Margin="5,0,0,0" HorizontalAlignment="Center" />

                            <StackPanel x:Name="stpAddNewFonction" Background="#66020A3E" Margin="10" >
                                <StackPanel Orientation="Horizontal" Margin="10,10,10,0">
                                    <StackPanel>                                        
                                        <StackPanel Orientation="Horizontal" Margin="5,0,5,5">
                                            <TextBlock Text=" Agent : " Width="100" Margin="0,3,5,3" Foreground="White"/>                                   
                                            <ComboBox  x:Name="cbxAgent" MinWidth="300" Padding="3" Margin="0,3" FontWeight="Bold" FontSize="14" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5,0,5,5">
                                            <TextBlock Text=" N° Mtrl : " Width="100" Margin="0,3,5,3" Foreground="White"/>
                                            <ComboBox x:Name="cbxMatric" Width="200" Padding="3" Margin="0,3" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5,0,5,5">
                                            <TextBlock Text=" Fonction : " MinWidth="100" Margin="0,3,5,3" Foreground="White"/>
                                            <TextBox x:Name="tbxFontion"  Width="300" Padding="3" Margin="0,3" IsReadOnly="True" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5,0,5,5">
                                            <TextBlock Text=" Lieu d'affectation : " Width="100" Margin="0,3,5,3" Foreground="White"/>
                                            <TextBox x:Name="tbxSite"  MinWidth="300" Padding="3" Margin="0,0,0,3" IsReadOnly="True" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5,0,5,5">
                                            <TextBlock Text=" Contact : " Width="100" Margin="0,3,5,3" Foreground="White"/>
                                            <TextBox x:Name="tbxContact"  Width="300" Padding="3" Margin="0,3" IsReadOnly="True" />
                                        </StackPanel>


                                    </StackPanel>
                                    
                                    <Border Width="1" BorderThickness="1" >
                                        <Border.BorderBrush>
                                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                <GradientStop Color="Black" Offset="0"/>
                                                <GradientStop Color="White" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.BorderBrush>
                                    </Border>

                                    <StackPanel Margin="10,0,0,0" >
                                        <StackPanel Orientation="Horizontal" Margin="10,0">
                                            <TextBlock Text=" Banque : "  MinWidth="50" Margin="3" Foreground="White"/>
                                            <ComboBox x:Name="cbxBank" Width="100" Margin="3
                                                      " FontSize="14" FontWeight="Bold" />
                                            <Button Content=" + " Height="20" Background="#FF149100"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="10,5,10,10">
                                            <TextBlock Text=" Compte : "  MinWidth="50" Margin="3" VerticalAlignment="Center" Foreground="White"/>
                                            <TextBox x:Name="tbxNumCompt" Width="300" Margin="3" FontSize="14" FontWeight="Bold" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Background="#7F446A59" Margin="15,0,0,0" >
                                            <Button  x:Name="btnCancel" Content=" Annuler " Width="100" Margin="10" />
                                            <Button x:Name="btnValidNewData" Content="Valider" Width="100" Height="30" HorizontalContentAlignment="Center" Margin="10"  Background="#FF004700" Foreground="White"/>
                                        </StackPanel>

                                    </StackPanel>
                                </StackPanel>


                            </StackPanel>

                            <DataGrid x:Name="DgBanque" AutoGenerateColumns="True" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

    </Grid>
</UserControl>
