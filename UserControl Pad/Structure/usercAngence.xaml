<UserControl x:Class="usercAngence"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lakey"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Grid.Row="0" Style="{StaticResource SectionHeaderBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MaxWidth="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition MaxWidth="200"/>
                </Grid.ColumnDefinitions>
                <Label Content="STRUCTURE" Foreground="{DynamicResource ThemeSectionHeaderTextBrush}" HorizontalContentAlignment="Center" FontSize="20" Grid.Column="1"/>
                <TextBox x:Name="BtnClientSiteSearch" Width="150" Height="36" Style="{StaticResource SearchButtonRounded}" Grid.Column="2"/>

            </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Background="#FF000A1D">
                <StackPanel>
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Label Content="AGENCES" Foreground="White"  FontSize="15" HorizontalContentAlignment="Center"/>
                            <TextBlock x:Name="tblNbAgence" Text=" Nombre de contrats en cours de validité : "  Background="#FF150452" Foreground="LightSkyBlue" />
                            <DataGrid x:Name="DgAgency" AutoGenerateColumns="True" />
                            <Grid x:Name="grdAddNewAgence" Background="#FF00002D">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="60"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width=" 410"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#FF1E2C58" >
                                    <StackPanel VerticalAlignment="Top">
                                        <TextBlock TextWrapping="Wrap" Text="Nouvelle AGENCE" FontSize="22" Foreground="#FFD1F9F6" Margin="20,5,0,0"/>
                                        <TextBlock x:Name="TblSocieteName"  TextWrapping="Wrap" Text="SOCIETE" FontSize="12" Foreground="#FFD1F9F6" Margin="0,5,0,10" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    </StackPanel>

                                </Border>
                                <Border Grid.Row="1" Grid.Column="0" Background="#FF070125" >
                                    <StackPanel Margin="0,10,0,0" >
                                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                                            <TextBlock  Text="Code Agence :" Foreground="White" Width="110" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TbxAgenceCode" Width="120" FontSize="14"/>
                                            <TextBlock Text="En activité :" Foreground="White" Width="70" Margin="15,0,0,0"/>
                                            <CheckBox x:Name="ChbActif"  Background="{DynamicResource ThemeCardBrush}" Foreground="{DynamicResource ThemeInkBrush}" IsChecked="True" FlowDirection="RightToLeft" HorizontalAlignment="Left"/>

                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                                            <TextBlock  Text="DESIGNATION :" Foreground="White" Width="110" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TbxAgenceName" Width="280" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                                            <TextBlock Text="CONTACTS :" Foreground="White" Width="110" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TbxConctacts"  Width="280" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                                            <TextBlock  Text="Adresse :" Foreground="White" Width="110" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TbxAdresse" Width="280" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                                            <TextBlock Text="Ville :" Foreground="White" Width="110" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TbxVille"  Width="280" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                                            <TextBlock  Text="Pays :" Foreground="White" Width="110" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            <ComboBox x:Name="CbxPays" Width="280" FontSize="14" IsTextSearchEnabled="True"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Visibility="Collapsed"  Margin="0,0,0,10">
                                            <TextBlock Text="Date de création :" Foreground="White" Width="110" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            <DatePicker x:Name="DtpDateCreation"  Width="280" FontSize="14"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                                            <TextBlock Text="Chef/Responsable :" Foreground="White" Width="110" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            <TextBox x:Name="TbxResponsable"  Width="280" FontSize="14"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                                        </StackPanel>
                                        <Button x:Name="BtnSave" Content="Enregistrer les données" Padding="30,0,30,0" Height="36" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ThemeActionNeutralTextBrush}"  HorizontalAlignment="Center"/>


                                    </StackPanel>

                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Background="#FF3A3A3A" >
                                    <StackPanel Margin="0,10,0,0" >
                                        <DataGrid x:Name="dgAgence" AutoGenerateColumns="True"/>
                                    </StackPanel>

                                </Border>

                            </Grid>

                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

    </Grid>
</UserControl>
