<UserControl x:Class="usercFonction"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lakey"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ControlTemplate TargetType="TextBox" x:Key="FillTextBox">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width=" 1*" MinWidth="150"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                <Border CornerRadius="12"
                        BorderThickness="1"
                        Background="{ TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Grid.Row="0">
                    <TextBlock Text="*"/>                    
                    
                </Border>
                </StackPanel>
            </Grid>
        </ControlTemplate>
    </UserControl.Resources>
    <Grid >
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Grid.Row="0" Style="{StaticResource SectionHeaderBorder}">
            <Label Content="FONCTION" Foreground="{DynamicResource ThemeSectionHeaderAccentBrush}" HorizontalContentAlignment="Center" FontSize="20"/>

        </Border>
        <Border Grid.Row="1" Background="#B200002D">
            <StackPanel Orientation="Horizontal"  Margin="10" Background="#7F0B142E">
                <StackPanel x:Name="stpAddNewFonction" Background="#4C02233E" >
                    <StackPanel Orientation="Horizontal" Margin="10,10,10,0">
                        <TextBlock Text=" Fonction : " MinWidth="150" Margin="0,10,5,5" VerticalAlignment="Center" Foreground="White"/>
                        <TextBox x:Name="tbxFonctionName" Width="auto" Height="36" MaxWidth="300" MinWidth="200" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,5,10,0" >
                        <TextBlock Text=" Niveau : "  MinWidth="150" Margin="0,10,5,5" VerticalAlignment="Center" Foreground="White"/>
                        <TextBox x:Name="tbxFonctionNiveau"  Width="auto"  Height="36" MaxWidth="300" MinWidth="50" VerticalAlignment="Center" Text="0" Padding="3,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,5,10,0" >
                        <TextBlock Text=" Description : "  MinWidth="150" Margin="0,3,5,5" VerticalAlignment="Top" Foreground="White"/>
                        <TextBox x:Name="tbxFonctionDescription"  Width="auto"  Height="50" MaxWidth="300" MinWidth="200" VerticalAlignment="Center" AcceptsReturn="True"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,5,10,0">
                        <TextBlock Text=" Actif : "  MinWidth="150" Margin="0,10,5,5" VerticalAlignment="Center" Foreground="White"/>
                        <CheckBox x:Name="ckbxFonctionActif" IsChecked="True" Margin=" 10" HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,5">
                        <TextBlock Text=" Fonction par défaut : "  MinWidth="150" Margin="0,10,5,5" VerticalAlignment="Center" Foreground="White"/>
                        <CheckBox x:Name="ckbxFonctionDefaut" IsChecked="False" Margin=" 10" HorizontalContentAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                        <Button  x:Name="btnCancel" Content=" Annuler " Width="100" Margin="10" />
                        <Button x:Name="btnValidNewFontion" Content="AJOUTER" Width="100" Height="36" HorizontalContentAlignment="Center" Margin="10"  Background="{DynamicResource ThemeActionSuccessBrush}" Foreground="{DynamicResource ThemeActionSuccessTextBrush}"/>
                        <Button x:Name="btnDelete" Content=" SUPPRIMER " Width="100" Margin="10" Foreground="{DynamicResource ThemeActionDangerTextBrush}" Background="{DynamicResource ThemeActionDangerBrush}" />

                    </StackPanel>
                </StackPanel>
                <StackPanel >
                    <TextBlock x:Name="tblNbFonction" Text=" Nombre de fonctions  : "  Background="#FF150452" Foreground="LightSkyBlue" />
                    <DataGrid x:Name="DgFonction" AutoGenerateColumns="True" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
