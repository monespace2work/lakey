<UserControl x:Class="usercSociete"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lakey"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="0" Style="{StaticResource SectionHeaderBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MaxWidth="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition MaxWidth="200"/>
                </Grid.ColumnDefinitions>
                <Label Content="STRUCRURE" Foreground="White" HorizontalContentAlignment="Center" FontSize="20" Grid.Column="1"/>
                <TextBox x:Name="BtnClientSiteSearch" Width="150" Height="28" Style="{StaticResource SearchButtonRounded}" Grid.Column="2"/>
            </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <Border BorderBrush="Black" BorderThickness="1" Background="#FF000A1D">
                <StackPanel>
                    <Grid >
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <Label Content="SOCIETE" Foreground="White"  FontSize="15" HorizontalContentAlignment="Center"/>
                                    <!--TextBlock x:Name="tblNbTructureSociete" Text=" Nombre de contrats en cours de validité : "  Background="#FF150452" Foreground="LightSkyBlue" /-->
                                    <!--DataGrid x:Name="DgStructure" AutoGenerateColumns="True" /-->
                                    <StackPanel >
                                        <StackPanel Orientation="Horizontal" Margin="5,5,0,0" >
                                            <TextBlock Text="Nom de la société" Height="14" Width="205" Foreground="White"/>
                                            <TextBox x:Name="tbxSteNom" MinWidth="475" Background="#FFD9E1F9"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5,5,0,0" >
                                            <TextBlock Text="Sigle" Height="14" Width="205" Foreground="White"/>
                                            <TextBox x:Name="tbxSteSigle"  MinWidth="475" Background="#FFD9E1F9"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5,5,0,0" >
                                            <TextBlock Text="Adresse siège" Height="14" Width="205" Foreground="White"/>
                                            <TextBox x:Name="tbxSteAdress"  MinWidth="475" Background="#FFD9E1F9"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5,5,0,0" >
                                            <TextBlock Text="Ville siège" Height="14" Width="205" Foreground="White"/>
                                            <TextBox x:Name="tbxSteVille"  MinWidth="475" Background="#FFD9E1F9"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5,5,0,0" >
                                            <TextBlock Text="Pays siège" Height="14" Width="205" Foreground="White"/>
                                            <TextBox x:Name="tbxStePays"  MinWidth="475" Background="#FFD9E1F9"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5,5,0,0" >
                                            <TextBlock Text="N° Tél officiel" Height="14" Width="205" Foreground="White"/>
                                            <TextBox x:Name="tbxSteTelephone"  MinWidth="475" Background="#FFD9E1F9"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5,5,0,0" >
                                            <TextBlock Text="Boite postale " Height="14" Width="205" Foreground="White"/>
                                            <TextBox x:Name="tbxSteBP"  MinWidth="475" Background="#FFD9E1F9"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5,5,0,0" >
                                            <TextBlock Text="N° d'identification fiscal (NIF)" Height="14" Width="205" Foreground="White"/>
                                            <TextBox x:Name="tbxSteNif"  MinWidth="475" Background="#FFD9E1F9"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5,5,0,0" >
                                            <TextBlock Text="N° au registre du commerce (RCCM) : " Height="14" Width="205" Foreground="White"/>
                                            <TextBox x:Name="tbxSteRccm"  MinWidth="475" Background="#FFD9E1F9"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5,5,0,0" >
                                            <TextBlock Text="N° employeur CNSS" Height="14" Width="205" Foreground="White"/>
                                            <TextBox x:Name="tbxSteCnss"  MinWidth="475" Background="#FFD9E1F9"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5,5,0,0" >
                                            <TextBlock Text="Adresse mail" Height="14" Width="205" Foreground="White"/>
                                            <TextBox x:Name="tbxSteMail"  MinWidth="475" Background="#FFD9E1F9"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5,5,0,0" >
                                            <TextBlock Text="Site web" Height="14" Width="205" Foreground="White"/>
                                            <TextBox x:Name="tbxSteWeb"  MinWidth="475" Background="#FFD9E1F9"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1">
                                    <Image x:Name="imgLogo" Source="/Lakey;component/MyIco.png" VerticalAlignment="Top"/>
                                </Border>

                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <Button  x:Name="btnCancel" Content="ANNULER" Margin="200,10"/>
                            <Button x:Name="btnSave" Content="ENREGISTRER" Margin="100,0,100,10"/>

                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

    </Grid>
</UserControl>
