<UserControl x:Class="usercClients"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lakey"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Grid.Row="0" Style="{StaticResource SectionHeaderBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MaxWidth="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition MaxWidth="200"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1">
                    <StackPanel HorizontalAlignment="Center">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition MaxWidth="70" />
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" MaxWidth="45" Background="#CCFFFFFF" CornerRadius="20">
                                <Image MaxWidth="40" Source="client2.png" Stretch="Uniform" Margin="3"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center">
                                <Label Content="CLIENTS" Foreground="{DynamicResource ThemeSectionHeaderTextBrush}" HorizontalContentAlignment="Center" FontSize="20" />
                            </StackPanel> 
                            </Grid> 
                        
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Grid.Column="2" HorizontalAlignment="Right" >
                    <TextBox x:Name="BtnClientSearch" Width="150" Height="36" Style="{StaticResource SearchButtonRounded}" KeyDown="BtnClientSearch_KeyDown"/>
                    <Border Background="#FFF3E0FF" Margin=" 5" Width="30" >
                        <Button x:Name="btnAgrandir" Margin="5" BorderBrush="{x:Null}"  >
                            <Button.Background>
                                <ImageBrush ImageSource="/Lakey;component/UserControl Pad/AgentSub/btnAgrandir.png" Stretch="Uniform"/>
                            </Button.Background>
                        </Button>
                    </Border>

                </StackPanel>

            </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1" Grid.Column="0">
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Background="#7F000A1D">
                <StackPanel>
                    <Grid Background="#E52C2C2C" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="5,0">
                            <StackPanel Orientation="Horizontal">
                                <Label Content="CLIENTS ACTIFS" Foreground="White" HorizontalContentAlignment="Center" FontSize="15"/>
                                <Button x:Name="btnExportExcelClientActif" MinWidth="30" MinHeight="30" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="White" Margin="10,0,0,0" >
                                    <Button.Background>
                                        <ImageBrush ImageSource="Logo_excel.png" Stretch="Uniform"/>
                                    </Button.Background>
                                </Button>
                            </StackPanel>
                            <TextBox x:Name="tbxNbClientActifs" Text=" Nombre de clients actif "  Background="#FF150452" Foreground="LightSkyBlue" HorizontalContentAlignment="Center"/>
                            <DataGrid x:Name="DgClients" AutoGenerateColumns="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="5,0">
                            <StackPanel Orientation="Horizontal">
                                <Label Content="CLIENTS INACTIFS" Foreground="White" HorizontalContentAlignment="Center" FontSize="15"/>
                                <Button x:Name="btnExportExcelClientInactif" MinWidth="30" MinHeight="30" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="White" Margin="10,0,0,0" >
                                    <Button.Background>
                                        <ImageBrush ImageSource="Logo_excel.png" Stretch="Uniform"/>
                                    </Button.Background>
                                </Button>
                            </StackPanel>
                                <TextBox x:Name="tbxNbClientInactifs" Text=" Nombre de clients inactif "  Background="#FF150452" Foreground="LightSkyBlue" HorizontalContentAlignment="Center"/>
                            <DataGrid x:Name="DgClientsInactifs" AutoGenerateColumns="True" />
                        </StackPanel>
                    </Grid>                    
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
