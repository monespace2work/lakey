<UserControl x:Class="usercAgents"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lakey"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="56"/>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border BorderThickness="1" Grid.Row="0" ScrollViewer.CanContentScroll="True" Style="{StaticResource SectionHeaderBorder}">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Label Content="ETATS DES AGENTS" Foreground="{DynamicResource ThemeSectionHeaderTextBrush}" HorizontalContentAlignment="Center" FontSize="20"/>
                    <Ellipse x:Name="elpGlobale" Height="20" Width="20" Fill="OrangeRed" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/>
                </StackPanel>
                <Border  Grid.Column="1" Background="#FFF3E0FF" Margin=" 5" >
                    <Button x:Name="btnAgrandir" Margin="5" BorderBrush="{x:Null}"  >
                        <Button.Background>
                            <ImageBrush ImageSource="/Lakey;component/UserControl Pad/AgentSub/btnAgrandir.png" Stretch="Uniform"/>
                        </Button.Background>
                    </Button>
                </Border>

            </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1" CanContentScroll="True" HorizontalScrollBarVisibility="Auto">
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Background="#7F000A1D">
                <StackPanel>
                    <Grid >
                        <StackPanel >
                            <StackPanel >
                                <Grid  Background="#FF150452" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition MinWidth="250" Width="3*"/>
                                        <ColumnDefinition MinWidth="200"  Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Visible">
                                            <Ellipse x:Name="elpStatus" Fill="Red" Width="10" Height=" 10" Visibility="Collapsed" />
                                        </WrapPanel>
                                        <TextBlock x:Name="tblNbAgents" Text="Nb agents : " Foreground="LightSkyBlue" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <WrapPanel Orientation="Horizontal"  Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,7,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Début :"  Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="40"/>
                                                <DatePicker  x:Name="dtpDebutSearch" FontSize="12" VerticalAlignment="Center" Text=""  Width="100" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Fin :"  Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="40"/>
                                                <DatePicker  x:Name="dtpFinSearch" FontSize="12" VerticalAlignment="Center" Text=""  Width="100" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBox x:Name="BtnAgentSearch" Width="150" Height="36" Style="{StaticResource SearchButtonRounded}" />
                                        <Button x:Name="btnExportExcel" MinWidth="30" MinHeight="30" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="White" >
                                            <Button.Background>
                                                <ImageBrush  Stretch="Uniform" ImageSource="Logo_excel.png"/>
                                            </Button.Background>
                                        </Button>

                                    </WrapPanel>
                                </Grid>
                            </StackPanel >

                            <DataGrid x:Name="DgEmployes" AutoGenerateColumns="True" Background="{DynamicResource ThemeCardBrush}" >
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <!--MenuItem Header="Modifier" Name="cmiModif"/-->
                                        <!--MenuItem Header="Supprimer" Background="#FF4D0000" Name="cmiSuppr" Foreground="White"/-->
                                        <!--Separator/-->
                                        <!--MenuItem Header="Copier"/>
                                        <Separator/-->
                                        <MenuItem Header="Contrat" Name="cmiContrat" />
                                        <MenuItem Header="Affectation" Name="cmiAffectation" />
                                        <MenuItem Header="Abence/Permission" Name="cmiAbsence" />
                                        <Separator/>
                                        <MenuItem Header="Résumé" Name="cmiResume" />

                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>



    </Grid>
</UserControl>
