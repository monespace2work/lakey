<UserControl x:Class="usercAgentsHeureSupp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lakey"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border  Grid.Row="0"  Style="{StaticResource SectionHeaderBorder}">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <StackPanel >
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MaxWidth="70" />
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" MaxWidth="45" Background="#CCFFFFFF" CornerRadius="20">
                            <Image MaxWidth="40" Source="planning.png" Stretch="Fill"  />
                        </Border>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center">
                            <Label Content="EMPLOYES"  Foreground="{DynamicResource ThemeSectionHeaderTextBrush}" HorizontalContentAlignment="Center" FontSize="20" FontWeight="Bold" Grid.Column="1"/>
                            <Label Content=" / "  Foreground="{DynamicResource ThemeSectionHeaderAccentBrush}" HorizontalContentAlignment="Center" FontSize="20" FontWeight="Bold" Grid.Column="1"/>
                            <Label Content="HEURES SUPPLEMENTAIRES"  Foreground="{DynamicResource ThemeSectionHeaderAccentBrush}" HorizontalContentAlignment="Center" FontSize="20" FontWeight="Bold" Grid.Column="1"/>
                            <Button x:Name="btnPointG" Content="Point du mois" Margin="30,10,15,15" Padding="10,1" Background="{DynamicResource ThemeActionPointBrush}" ToolTip="POINT POUR LE SALAIRE" Foreground="{DynamicResource ThemeActionPointTextBrush}"/>
                        </StackPanel>
                        </Grid>
                </StackPanel>
                <Border  Grid.Column="1" Background="#FFF3E0FF" Margin=" 5" >
                    <Button x:Name="btnAgrandir" Margin="2" BorderBrush="{x:Null}"  >
                        <Button.Background>
                            <ImageBrush ImageSource="/Lakey;component/UserControl Pad/AgentSub/btnAgrandir.png" />
                        </Button.Background>
                    </Button>
                </Border>
            </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Background="#FF000A1D">
                <StackPanel>
                    <Grid >
                        <StackPanel >
                            <StackPanel >
                                <Grid  Background="#FF150452" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition MaxWidth="350"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition MinWidth="200"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Visible">
                                            <Label Content="HEURES SUP." Foreground="#FF9DFF87"  FontSize="12" FontStretch="ExtraExpanded" HorizontalContentAlignment="Center" Background="{x:Null}" FontWeight="Bold" Margin="10,0,0,0" />
                                            <Label Content=" / " Foreground="LightSkyBlue"  FontSize="12" FontStretch="ExtraExpanded" HorizontalContentAlignment="Center" Background="{x:Null}" />
                                            <Label Content="H. S." Foreground="White"  FontSize="12" FontStretch="ExtraExpanded" HorizontalContentAlignment="Center" Background="{x:Null}"  />
                                            <Ellipse x:Name="elpStatus" Fill="Red" Width="10" Height=" 10" Visibility="Collapsed" />
                                        </WrapPanel>
                                        <TextBlock x:Name="tblNbAgentHeureSupp" Text=" Nombre d'heure sup. : "  Background="#FF150452" Foreground="LightSkyBlue" />


                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button x:Name="btnNewData" Content="NOUVEAU" MinWidth="100" Margin=" 8" Padding="5"/>
                                        <Button x:Name="btnDeleteAg" Content="SUPPRIMER" MinWidth="100" Margin=" 8" Visibility="Collapsed" Background="{DynamicResource ThemeActionDangerBrush}" Foreground="{DynamicResource ThemeActionDangerTextBrush}"/>
                                        <Button x:Name="btnRefresh" Content="ACTUALISER" Background="{DynamicResource ThemeSuccessButtonBrush}" Foreground="{DynamicResource ThemeSuccessButtonTextBrush}" Margin=" 12"  Width="80"/>
                                    </StackPanel>
                                    <WrapPanel Orientation="Horizontal"  Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,7,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Début :"  Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="40"/>
                                                <DatePicker  x:Name="dtpDebutSearch" FontSize="12" VerticalAlignment="Center" Text=""  Width="100" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Fin :"  Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="40"/>
                                                <DatePicker  x:Name="dtpFinSearch" FontSize="12" VerticalAlignment="Center" Text=""  Width="100" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBox x:Name="BtnAgentAbsenceSearch" Width="150" Height="36" Style="{StaticResource SearchButtonRounded}" />
                                        <Button x:Name="btnExportExcel" MinWidth="30" MinHeight="30" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="White" >
                                            <Button.Background>
                                                <ImageBrush ImageSource="Logo_excel.png" Stretch="Uniform"/>
                                            </Button.Background>
                                        </Button>

                                    </WrapPanel>
                                </Grid>

                            </StackPanel >
                            <StackPanel x:Name="stpSaisie" Visibility="Collapsed"   >
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="100"><Run Text="Nom"/><Run Text=" &amp; prénons"/><Run Text="  : "/></TextBlock>
                                        <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                                        <Grid>
                                            <ComboBox x:Name="CbxNom" MinWidth="300" Height="36" FontSize="14" VerticalAlignment="Top" />
                                            <TextBlock  x:Name="TblIndicationNom" Text="Nom et prénoms " VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource ThemeInputPlaceholderBrush}"/>
                                        </Grid>
                                        <Grid Margin="8,0,0,0">
                                            <ComboBox x:Name="CbxNumMatr" MinWidth="150" Height="36" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed" />
                                            <TextBlock  x:Name="TblIndicationNumMatr" Text="N° Matricule " VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource ThemeInputPlaceholderBrush}" Margin="5,5,0,5" HorizontalAlignment="Left" Width="98" Visibility="Collapsed"/>
                                        </Grid>

                                    </StackPanel>
                                    <StackPanel Orientation ="Horizontal"  Margin="5">
                                        <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="109" Text="Site :"/>
                                        <ComboBox x:Name="cbxSite" Width="300" Height="36" FontSize="14" VerticalAlignment="Center" IsReadOnly="True" Background="{DynamicResource ThemeInputBrush}" Opacity="0.995" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="100"><Run Text="Début"/><Run Text=" "/><Run Text=" : "/></TextBlock>
                                        <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                                        <Grid>
                                            <DatePicker x:Name="dtpDebut" Width="110" Height="36" FontSize="14" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid Margin="8,0,0,0"/>
                                        <TextBlock MinWidth="25" Margin="10,5,5,5" VerticalAlignment="Center" Foreground="White" Width="111"><Run Text="Nombre de faction"/><Run Text=" "/><Run Text=" :"/></TextBlock>
                                        <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                                        <ComboBox  x:Name="CbxNbrFaction" Width="47" Height="36" FontSize="14" VerticalAlignment="Center" Background="{DynamicResource ThemeInputBrush}" >
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation ="Horizontal"  Margin="5">
                                        <TextBlock MinWidth="25" Margin="0,0,5,5" VerticalAlignment="Top" Foreground="White" Width="103"><Run Text="Observations "/><Run Text=": "/></TextBlock>
                                        <Grid>
                                            <TextBox x:Name="TbxObs" Height="63" FontSize="14"  TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Left" Width="400" AcceptsReturn="True" />
                                            <TextBlock  x:Name="TblIndicationObs" Text="Observations" IsHitTestVisible="False" Foreground="{DynamicResource ThemeInputPlaceholderBrush}" Margin="0,0,27,0"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel x:Name="stpButtonsPad" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5" Visibility="Collapsed">
                                        <Button x:Name="btnAnnule" Content="Annuler l'opération" Margin="0,0,10,0" Padding="10,5"/>
                                        <Button x:Name="btnSave" Content="Enregistrer et fermer" Margin="0,0,10,0"  Padding="10,5"/>
                                        <Button x:Name="btnSaveContinue" Content="Enregistrer et ajouter un autre" Padding="10,5"/>
                                    </StackPanel>

                                </StackPanel>

                            </StackPanel>


                            <DataGrid x:Name="DgAgentHeureSupp" AutoGenerateColumns="True" Background="{DynamicResource ThemeSpecialTableBrush}" >
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Modifier" Name="cmiModif"/>
                                        <MenuItem Header="Supprimer" Background="{DynamicResource ThemeActionDangerBrush}" Name="cmiSuppr" Foreground="{DynamicResource ThemeActionDangerTextBrush}"/>
                                        <Separator/>
                                        <MenuItem Header="Copier"/>
                                        <Separator/>
                                        <MenuItem Header="Contrat" Name="cmiContrat" />
                                        <MenuItem Header="Affectation" Name="cmiAffectation" />
                                        <MenuItem Header="Abence/Permission" Name="cmiAbsence" />
                                        <Separator/>
                                        <MenuItem Header="Résumé" Name="cmiResume" />

                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

    </Grid>
</UserControl>
