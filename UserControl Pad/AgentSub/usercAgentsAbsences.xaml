<UserControl x:Class="usercAgentsAbsences"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lakey"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border  Grid.Row="0"  Style="{StaticResource SectionHeaderBorder}">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MaxWidth="70" />
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" MaxWidth="45" Background="#CCFFFFFF" CornerRadius="20">
                            <Image MaxWidth="40" Source="ABSENCES- 2.png" Stretch="Fill"  Margin="3"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center">

                            <Label Content="EMPLOYES"  Foreground="{DynamicResource ThemeSectionHeaderTextBrush}" HorizontalContentAlignment="Center" FontSize="20" FontWeight="Bold" Grid.Column="1"/>
                            <Label Content=" / "  Foreground="{DynamicResource ThemeSectionHeaderAccentBrush}" HorizontalContentAlignment="Center" FontSize="20" FontWeight="Bold" Grid.Column="1"/>
                            <Label Content="ABSENCES/CONGES"  Foreground="{DynamicResource ThemeSectionHeaderAccentBrush}" HorizontalContentAlignment="Center" FontSize="20" FontWeight="Bold" Grid.Column="1"/>
                            <StackPanel Orientation="Horizontal" Margin="30,0,0,0" Background="#4C000000" VerticalAlignment="Center" >
                                <Label Content="Point mensuel" Foreground="{DynamicResource ThemeSectionHeaderAccentBrush}" VerticalAlignment="Center"/>
                                <Button x:Name="btnPointG" Content="Absences" Margin="10,10,1,15" Padding="10,1" Background="{DynamicResource ThemeActionPointBrush}" ToolTip="POINT POUR LE SALAIRE" Foreground="{DynamicResource ThemeActionPointTextBrush}"/>
                                <Button x:Name="btnPointConges" Content="Congés" Margin="10,10,15,15" Padding="10,1" Background="{DynamicResource ThemeCongesButtonBrush}" ToolTip="POINT POUR LE SALAIRE" Foreground="{DynamicResource ThemeCongesButtonTextBrush}"/>

                            </StackPanel>
                        </StackPanel>
                        </Grid>
                </StackPanel>
                <Border  Grid.Column="1" Background="#FFF3E0FF" Margin=" 5" >
                    <Button x:Name="btnAgrandir" Margin="5" BorderBrush="{x:Null}"  >
                        <Button.Background>
                            <ImageBrush ImageSource="/Lakey;component/UserControl Pad/AgentSub/btnAgrandir.png" />
                        </Button.Background>
                    </Button>
                </Border>
            </Grid>

        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <Border BorderBrush="{DynamicResource ThemeBorderBrush}" BorderThickness="1" Background="#7F000A1D">
                <StackPanel>
                    <Grid >
                        <StackPanel >
                            <StackPanel >
                                <Grid  Background="#FF150452" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition MaxWidth="350"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition MinWidth="200"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Visible">
                                            <Label Content="ABSENCES" Foreground="#FF9DFF87"  FontSize="12" FontStretch="ExtraExpanded" HorizontalContentAlignment="Center" Background="{x:Null}" FontWeight="Bold" Margin="10,0,0,0" />
                                            <Label Content=" / " Foreground="LightSkyBlue"  FontSize="12" FontStretch="ExtraExpanded" HorizontalContentAlignment="Center" Background="{x:Null}" />
                                            <Label Content="PERMISSIONS" Foreground="White"  FontSize="12" FontStretch="ExtraExpanded" HorizontalContentAlignment="Center" Background="{x:Null}"  />
                                            <Ellipse x:Name="elpStatus" Fill="Red" Width="10" Height=" 10" Visibility="Collapsed" />

                                        </WrapPanel>
                                        <TextBlock x:Name="tblNbAgentAbsence"  Foreground="LightSkyBlue" Margin="10,0,0,0" ><Run Text=" Nombre d'a"/><Run Text="bsences"/><Run Text=" : "/></TextBlock>

                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,10,0,0">
                                        <Button x:Name="btnNewData" Content="NOUVEAU" MinWidth="100" Margin=" 8" Padding="5"/>
                                        <Button x:Name="btnDeleteAg" Content="SUPPRIMER" MinWidth="100" Margin=" 8" Visibility="Collapsed" Background="{DynamicResource ThemeActionDangerBrush}" Foreground="{DynamicResource ThemeActionDangerTextBrush}"/>
                                        <Button x:Name="btnRefresh" Content="ACTUALISER" Background="{DynamicResource ThemeSuccessButtonBrush}" Foreground="{DynamicResource ThemeSuccessButtonTextBrush}" Margin=" 12"  Width="80"/>
                                    </StackPanel>
                                    <WrapPanel Orientation="Horizontal"  Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,7,0">
                                        <Ellipse x:Name="iLanceur" Width="20" Height="20" Fill="Brown" Visibility="Collapsed"/>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Début :"  Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="40"/>
                                                <DatePicker  x:Name="dtpDebutSearch" FontSize="12" VerticalAlignment="Center" Text=""  Width="100" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Fin :"  Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="40"/>
                                                <DatePicker  x:Name="dtpFinSearch" FontSize="12" VerticalAlignment="Center" Text=""  Width="100" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBox x:Name="BtnAgentAbsenceSearch" Width="150" Height="36" Style="{StaticResource SearchButtonRounded}" />
                                        <Button x:Name="btnExportExcel" MinWidth="30" MinHeight="30" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="White" >
                                            <Button.Background>
                                                <ImageBrush ImageSource="Logo_excel.png" Stretch="Uniform"/>
                                            </Button.Background>
                                        </Button>

                                    </WrapPanel>
                                </Grid>

                            </StackPanel >
                            <StackPanel x:Name="stpSaisie" Visibility="Collapsed" >
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Orientation="Horizontal" >
                                    <StackPanel Background="#FF060A66">
                                        <Grid >
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="100"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" Background="#FF0C0230">
                                                    <Label Content="DEMANDE - ENREGISTREMENTS" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"  Foreground="White" Padding="15,2,15,5"/>
                                                    <TextBlock MinWidth="25" Margin="7,5,5,5" VerticalAlignment="Center" Foreground="White" Width="120"><Run Text="Date de demande"/><Run Text=" "/><Run Text=" : "/></TextBlock>
                                                    <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                                                    <DatePicker x:Name="dtpDateDmdSdb" Width="110" Height="36" FontSize="14" VerticalAlignment="Center" FontWeight="Bold" />
                                                </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="5">
                                                    <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="100"><Run Text="Nom"/><Run Text=" &amp; prénons"/><Run Text="  : "/></TextBlock>
                                                    <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                                                    <Grid>
                                                        <ComboBox x:Name="CbxNomSdb" MinWidth="300" Height="36" FontSize="14" VerticalAlignment="Top" />
                                                        <TextBlock  x:Name="TblIndicationNomSdb" Text="Nom et prénoms " VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource ThemeInputPlaceholderBrush}"/>
                                                    </Grid>
                                                    <Grid Margin="8,0,0,0">
                                                        <ComboBox x:Name="CbxNumMatrSdb" MinWidth="100" Height="36" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed" />
                                                        <TextBlock  x:Name="TblIndicationNumMatrSdb" Text="N° Matricule " VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource ThemeInputPlaceholderBrush}" Margin="5,5,0,5" HorizontalAlignment="Left" Width="98" Visibility="Collapsed"/>
                                                    </Grid>
                                                </StackPanel>
                                                <!--**********************************-->
                                                <StackPanel Orientation="Horizontal" Margin="5">
                                                    <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="100"><Run Text="Motif"/><Run Text="  : "/></TextBlock>
                                                    <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                                                    <Grid>
                                                        <ComboBox x:Name="CbxMotifSdb" Width="300" Height="36" FontSize="14" VerticalAlignment="Bottom" />
                                                        <TextBlock  x:Name="TblIndicationMotifSdb" Text=" Motif" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource ThemeInputPlaceholderBrush}"/>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="5">
                                                    <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="100"><Run Text="Début"/><Run Text=" "/><Run Text=" : "/></TextBlock>
                                                    <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                                                    <Grid>
                                                        <DatePicker x:Name="dtpDebutSdb" Width="110" Height="36" FontSize="14" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock MinWidth="25" Margin="20,5,5,5" VerticalAlignment="Center" Foreground="White" Width="29"><Run Text="Fin "/><Run Text=": "/></TextBlock>
                                                    <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                                                    <Grid Margin="8,0,0,0">
                                                        <DatePicker  x:Name="dtpFinSdb" Width="110" Height="36" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                    </Grid>
                                                    <TextBlock MinWidth="25" Margin="10,5,5,5" VerticalAlignment="Center" Foreground="White" Width="39" Text="Durée :"/>
                                                    <TextBox x:Name="TbxDureeSdb" Width="47" Height="36" FontSize="14" VerticalAlignment="Center" IsReadOnly="True" Background="{DynamicResource ThemeInputBrush}" />
                                                    <Label  Content ="jours" Foreground="White"/>
                                                </StackPanel>
                                                <StackPanel Orientation ="Horizontal"  Margin="5">
                                                    <TextBlock MinWidth="25" Margin="0,0,5,5" VerticalAlignment="Top" Foreground="White" Width="103"><Run Text="Observations "/><Run Text=": "/></TextBlock>
                                                    <Grid>
                                                        <TextBox x:Name="TbxObsSdb" Height="36" FontSize="14"  TextWrapping="Wrap" VerticalAlignment="Top" Width="250" AcceptsReturn="True" />
                                                        <TextBlock  x:Name="TblIndicationObsSdb" Text="Observations" IsHitTestVisible="False" Foreground="{DynamicResource ThemeInputPlaceholderBrush}" Margin="0,0,27,0"/>
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel x:Name="stpButtonsPadSdb" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5" Visibility="Visible">
                                                    <Button x:Name="btnAnnuleSdb" Content="Annuler" Margin="0,0,10,0" Padding="10,5"/>
                                                    <CheckBox x:Name="chbEnAttente"  Content="METTRE EN ATTENTE" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="True"/>
                                                    <Button x:Name="btnSaveSdb" Content="VALIDER" Margin="0,0,10,0"  Padding="10,5"/>
                                                    <Expander  x:Name="expDecisionSdb" Header="ACCORD" Padding="5,7,10,5" Margin="20,0,0,0" Background="#FFF7FFC1" Width="150"  Visibility="Collapsed"> 
                                                        <StackPanel Orientation="Horizontal">
                                                            <CheckBox x:Name="chbAccord"  Content="Oui" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <CheckBox x:Name="chbNonAccord"  Content="Non" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                            <Button x:Name="btnValideDecision" Content="OK" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Margin="0,5" />
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>

                                            </StackPanel>
                                            <DataGrid Grid.Row="1" x:Name="dgEnAttente" AutoGenerateColumns="True"
                                                      AlternatingRowBackground="{DynamicResource ThemePendingAlternateRowBrush}"
                                                      RowBackground="{DynamicResource ThemePendingRowBrush}"
                                                      Foreground="{DynamicResource ThemePendingRowTextBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                    <Button x:Name="btnExtend" Content=">"/>
                                    <StackPanel x:Name="stpDecision" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Background="#FF0C0230">
                                            <Label Content="DECISION - ACCORD/REJET" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FF0C0230" Foreground="White" Padding="15,2,15,5"/>
                                            <TextBlock MinWidth="25" Margin="7,5,5,5" VerticalAlignment="Center" Foreground="White" Width="120"><Run Text="Date de demande"/><Run Text=" "/><Run Text=" : "/></TextBlock>
                                            <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                                            <DatePicker x:Name="dtpDateDmd" Width="110" Height="36" FontSize="14" VerticalAlignment="Center" FontWeight="Bold" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5">
                                            <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="100"><Run Text="Nom"/><Run Text=" &amp; prénons"/><Run Text="  : "/></TextBlock>
                                            <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                                            <Grid>
                                                <ComboBox x:Name="CbxNom" MinWidth="300" Height="36" FontSize="14" VerticalAlignment="Top" />
                                                <TextBlock  x:Name="TblIndicationNom" Text="Nom et prénoms " VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource ThemeInputPlaceholderBrush}"/>
                                            </Grid>
                                            <Grid Margin="8,0,0,0">
                                                <ComboBox x:Name="CbxNumMatr" MinWidth="100" Height="36" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed" />
                                                <TextBlock  x:Name="TblIndicationNumMatr" Text="N° Matricule " VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource ThemeInputPlaceholderBrush}" Margin="5,5,0,5" HorizontalAlignment="Left" Width="98" Visibility="Collapsed"/>
                                            </Grid>

                                        </StackPanel>
                                        <StackPanel Orientation ="Horizontal"  Margin="5">
                                            <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="109" Text="Site :"/>
                                            <TextBox x:Name="TbxSite" Width="300" Height="36" FontSize="14" VerticalAlignment="Center" IsReadOnly="True" Background="{DynamicResource ThemeInputBrush}" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="5">
                                            <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="100"><Run Text="Motif"/><Run Text="  : "/></TextBlock>
                                            <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                                            <Grid>
                                                <ComboBox x:Name="CbxMotif" Width="300" Height="36" FontSize="14" VerticalAlignment="Bottom" />
                                                <TextBlock  x:Name="TblIndicationMotif" Text=" Motif" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource ThemeInputPlaceholderBrush}"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5">
                                            <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="100"><Run Text="Début"/><Run Text=" "/><Run Text=" : "/></TextBlock>
                                            <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                                            <Grid>
                                                <DatePicker x:Name="dtpDebut" Width="110" Height="36" FontSize="14" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock MinWidth="25" Margin="20,5,5,5" VerticalAlignment="Center" Foreground="White" Width="29"><Run Text="Fin "/><Run Text=": "/></TextBlock>
                                            <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                                            <Grid Margin="8,0,0,0">
                                                <DatePicker  x:Name="dtpFin" Width="110" Height="36" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                            </Grid>
                                            <TextBlock MinWidth="25" Margin="10,5,5,5" VerticalAlignment="Center" Foreground="White" Width="39" Text="Durée :"/>
                                            <TextBox x:Name="TbxDuree" Width="47" Height="36" FontSize="14" VerticalAlignment="Center" IsReadOnly="True" Background="{DynamicResource ThemeInputBrush}" />
                                            <Label  Content ="jours" Foreground="White"/>
                                        </StackPanel>
                                        <StackPanel Orientation ="Horizontal"  Margin="5">
                                            <TextBlock MinWidth="25" Margin="0,0,5,5" VerticalAlignment="Top" Foreground="White" Width="103"><Run Text="Observations "/><Run Text=": "/></TextBlock>
                                            <Grid>
                                                <TextBox x:Name="TbxObs" Height="63" FontSize="14"  TextWrapping="WrapWithOverflow" VerticalAlignment="Top" HorizontalAlignment="Left" Width="400" AcceptsReturn="True" />
                                                <TextBlock  x:Name="TblIndicationObs" Text="Observations" IsHitTestVisible="False" Foreground="{DynamicResource ThemeInputPlaceholderBrush}" Margin="0,0,27,0"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel x:Name="stpButtonsPad" Orientation="Horizontal" HorizontalAlignment="Center" Margin="5" Visibility="Collapsed">
                                            <Button x:Name="btnAnnule" Content="Annuler l'opération" Margin="0,0,10,0" Padding="10,5"/>
                                            <Button x:Name="btnSave" Content="Enregistrer et fermer" Margin="0,0,10,0"  Padding="10,5"/>
                                            <Button x:Name="btnSaveContinue" Content="Enregistrer et ajouter un autre" Padding="10,5"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                </ScrollViewer>
                            </StackPanel>

                            <Button x:Name="btnReduir" Content="^" Visibility="Collapsed"/>
                            <DataGrid x:Name="DgAgentAbsence" AutoGenerateColumns="True" >
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Modifier" Name="cmiModif"/>
                                        <MenuItem Header="Supprimer" Background="{DynamicResource ThemeActionDangerBrush}" Name="cmiSuppr" Foreground="{DynamicResource ThemeActionDangerTextBrush}"/>
                                        <Separator/>
                                        <MenuItem Header="Copier"/>
                                        <Separator/>
                                        <MenuItem Header="Contrat" Name="cmiContrat" />
                                        <MenuItem Header="Affectation" Name="cmiAffectation" />
                                        <MenuItem Header="Abence/Permission" Name="cmiAbsence" />
                                        <Separator/>
                                        <MenuItem Header="Résumé" Name="cmiResume" />

                                    </ContextMenu>
                                </DataGrid.ContextMenu>

                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

    </Grid>
</UserControl>
