<UserControl x:Class="usercAgentsPlanning"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lakey"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="Black" BorderThickness="1" Grid.Row="0" Style="{StaticResource SectionHeaderBorder}">
            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MaxWidth="70" />
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" MaxWidth="45" Background="#CCFFFFFF" CornerRadius="20">
                            <Image MaxWidth="40" Source="planning.png" Stretch="Fill"  Margin="3"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center">

                            <Label Content="EMPLOYES"  Foreground="White" HorizontalContentAlignment="Center" FontSize="20" FontWeight="Bold" Grid.Column="1"/>
                            <Label Content=" / "  Foreground="#FF87FF6D" HorizontalContentAlignment="Center" FontSize="20" FontWeight="Bold" Grid.Column="1"/>
                            <Label Content="PLANNING"  Foreground="#FF87FF6D" HorizontalContentAlignment="Center" FontSize="20" FontWeight="Bold" Grid.Column="1"/>
                            <Ellipse x:Name="elpStatus" Fill="Red" Width="10" Height=" 10" Visibility="Collapsed" />
                            <Button x:Name="btnRefresh" Content="ACTUALISER" Background="#FF87FF6D" Margin="30,12,12,12"  Width="80"/>
                        </StackPanel>
                        </Grid>
                </StackPanel>

                <Border  Grid.Column="1" Background="#FFF3E0FF" Margin=" 5" >
                    <Button x:Name="btnAgrandir" Margin="2" BorderBrush="{x:Null}"  >
                        <Button.Background>
                            <ImageBrush ImageSource="/Lakey;component/UserControl Pad/AgentSub/btnAgrandir.png" />
                        </Button.Background>
                    </Button>
                </Border>
            </Grid>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
            <StackPanel >
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*"/>
                            <ColumnDefinition Width="2*" MinWidth="150"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Background="#FF04005D">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"  MaxWidth="500" />
                                    <ColumnDefinition Width="3*"  MinWidth="100"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0 ">
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock Text="Site :" MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="50"/>
                                        <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                                        <Grid>
                                            <ComboBox x:Name="cbxSite" MinWidth="150" Height="26" FontSize="14" VerticalAlignment="Top" />
                                            <!--TextBlock  x:Name="TblIndicationSite"  Text="Site " VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray"/-->
                                        </Grid>

                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" >
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Début :"  Margin="5,5,5,5" VerticalAlignment="Center" Foreground="White" Width="50"/>
                                            <DatePicker  x:Name="dtpDebut12H24H" FontSize="12" VerticalAlignment="Center" Text=""  Width="100" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Fin :"  Margin="5,5,5,5" VerticalAlignment="Center" Foreground="White" Width="20"/>
                                            <DatePicker  x:Name="dtpFin12H24H" FontSize="12" VerticalAlignment="Center" Text=""  Width="100" />
                                        </StackPanel>
                                    </StackPanel>

                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Postes" MinWidth="25" Margin="5,5,5,5" VerticalAlignment="Center" Foreground="White" HorizontalAlignment="Left" />
                                    <Grid Margin="8,0,0,0">
                                        <ListBox x:Name="lbxNumPoste" MinWidth="100" MinHeight="40" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" Background="#FF030040" Foreground="White" >
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#FF010311"/>
                                                            <Setter Property="Foreground" Value="#FF87FF6D"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                        <!--TextBlock  x:Name="TblIndicationPoste" Text="N° Matricule " VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray" Margin="5,5,0,5" HorizontalAlignment="Left" Width="98" Visibility="Collapsed"/-->
                                    </Grid>

                                </StackPanel>
                            </Grid>
                            <Expander x:Name="xpdPlan12H" Header="Planning en 12 HEURES " Foreground="White" Margin="5,5,5,0" BorderBrush="White" Background="#FF0F122E">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="100"><Run Text="Nom"/><Run Text=" &amp; prénons"/><Run Text="  : "/></TextBlock>
                                        <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                                        <Grid>
                                            <ComboBox x:Name="CbxNom12H"  MinWidth="150" Height="26" FontSize="14" VerticalAlignment="Top" />
                                            <!--TextBlock  x:Name="TblIndicationNom12H" Text="Nom et prénoms " VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray"/-->
                                        </Grid>
                                        <TextBlock MinWidth="25" Margin="5,5,5,5" VerticalAlignment="Center" Foreground="White" Width="50" Text="Jr Repos"/>
                                        <Grid Margin="8,0,0,0">
                                            <ComboBox x:Name="CbxJrRepos" MinWidth="150" Height="25" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left"  />
                                            <!--TextBlock  x:Name="TblIndicationJrRepos" Text="Repos" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray" Margin="5,5,0,5" HorizontalAlignment="Left" Width="98" /-->
                                        </Grid>

                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel x:Name="spnRemplace" Orientation="Horizontal" Margin="5">
                                            <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="100" Text="Remplaçant"/>
                                            <Grid>
                                                <ComboBox x:Name="CbxNomRemplace12H"  MinWidth="150" Height="26" FontSize="14" VerticalAlignment="Top" />
                                                <!--TextBlock  x:Name="TblIndicationNomRemplace12H" Text="Nom et prénoms " VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray"/-->
                                            </Grid>

                                        </StackPanel>
                                        <Button x:Name="btnValider12H"  Content=" VALIDER" Padding="10,1,13,1" Margin="50,0,0,0" Width="121"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="xpdPlan24H" Header="Planning en 24 HEURES " Foreground="White" Margin="5,12,5,0" BorderBrush="#FF975151" Background="#FF2B2A75">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="100" Text="Agent 1"/>
                                        <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                                        <Grid>
                                            <ComboBox x:Name="CbxNom24H1" MinWidth="150" Height="26" FontSize="14" VerticalAlignment="Top" />
                                            <!--TextBlock  x:Name="TblIndicationNom24H1" Text="Agent 1" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray" Margin="5,5,0,5" HorizontalAlignment="Left" Width="98" /-->
                                        </Grid>

                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="100" Text="Agent 2"/>
                                        <Grid Margin="8,0,0,0">
                                            <ComboBox x:Name="CbxNom24H2" MinWidth="150" Height="25" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left"  />
                                            <!--TextBlock  x:Name="TblIndicationNom24H2" Text="Agent 2" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray" Margin="5,5,0,5" HorizontalAlignment="Left" Width="98" /-->
                                        </Grid>

                                    </StackPanel>
                                    <Button x:Name="btnValider24H"  Content=" VALIDER" Padding="10,1,13,1" Margin="50,0" Width="121"/>

                                </StackPanel>

                            </Expander>
                            <Expander x:Name="xpdPlanSubst"  Header="SUBSTITUTIONS / SUPPRESSION" Foreground="White" Background="#FF2D0A51" Margin="5,5,5,0" >
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" >
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Début :"  Margin="5,5,5,5" VerticalAlignment="Center" Foreground="White" Width="50"/>
                                            <DatePicker  x:Name="dtpDebutSubst" FontSize="12" VerticalAlignment="Center" Text=""  Width="100" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Fin :"  Margin="5,5,5,5" VerticalAlignment="Center" Foreground="White" Width="20"/>
                                            <DatePicker  x:Name="dtpFinSubst" FontSize="12" VerticalAlignment="Center" Text=""  Width="100" />
                                        </StackPanel>
                                        <Button x:Name="btnOkDate" Content=" OK " Margin="10,3,0,3" />
                                    </StackPanel>
                                    <StackPanel x:Name="stpSubstContent" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" Margin="5">
                                            <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="100" Text="Agent "/>
                                            <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                                            <Grid>
                                                <ComboBox x:Name="CbxAgentSortant" MinWidth="150" Height="26" FontSize="14" VerticalAlignment="Top" />
                                                <!--TextBlock  x:Name="TblIndicationAgentSortant" Text="Nom et prénoms " VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray"/-->
                                            </Grid>
                                            <TextBlock MinWidth="25" Margin="5,5,5,5" VerticalAlignment="Center" Foreground="White" Width="50" Text="Poste"/>
                                            <Grid Margin="8,0,0,0">
                                                <ComboBox x:Name="CbxPosteRemplace" MinWidth="150" Height="25" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left"  />
                                                <!--TextBlock  x:Name="TblIndicationPosteRemplace" Text="Poste conserné" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray" Margin="5,5,0,5" HorizontalAlignment="Left" Width="98" /-->
                                            </Grid>

                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="5">
                                            <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="100" Text="Remplaçant"/>
                                            <Grid>
                                                <ComboBox x:Name="CbxAgentEntrant" MinWidth="150" Height="26" FontSize="14" VerticalAlignment="Top" />
                                                <!--TextBlock  x:Name="TblIndicationAgentEntrant" Text="Nom et prénoms " VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray"/-->
                                            </Grid>
                                            <Button x:Name="btnCancelSubstitution"  Content="ANNULER" Padding="10,1,13,1" Margin="30,0,0,0" Width="80"/>
                                            <Button x:Name="btnValiderSubstitution"  Content="REMPLACER" Padding="10,1,13,1" Margin="20,0,0,0" Width="90" Background="DarkOrange"/>
                                            <Button x:Name="btnValiderSuppr"  Content="SUPPRIMER" Padding="10,1,13,1" Margin="20,0,0,0" Width="90" Background="#FF6A0000" Foreground="White"/>

                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                        </StackPanel>
                        <StackPanel Grid.Column="1" Background="#FF0B004D">
                            <Expander x:Name="xpdPlanHebdo" Header="Planning Hebdomadaire"  Foreground="White">
                                <StackPanel >
                                    <StackPanel Orientation="Horizontal" >
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Début :"  Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="40"/>
                                            <DatePicker  x:Name="dtpDebutHebdo" FontSize="12" VerticalAlignment="Center" Text=""  Width="100" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Fin :"  Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="40"/>
                                            <DatePicker  x:Name="dtpFinHebdo" FontSize="12" VerticalAlignment="Center" Text=""  Width="100" />
                                        </StackPanel>

                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="100"><Run Text="Nom"/><Run Text=" &amp; prénons"/><Run Text="  : "/></TextBlock>
                                        <TextBlock Text="* " Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" />
                                        <Grid>
                                            <ComboBox x:Name="CbxNomHebdo"  MinWidth="200" Height="26" FontSize="14" VerticalAlignment="Top" />
                                            <!--TextBlock  x:Name="TblIndicationNomHebdo" Text="Nom et prénoms " VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray"/-->
                                        </Grid>
                                        <Grid Margin="8,0,0,0">
                                            <ComboBox x:Name="CbxNumMatr" MinWidth="150" Height="25" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" Visibility="Collapsed" />
                                            <TextBlock  x:Name="TblIndicationNumMatr" Text="N° Matricule " VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray" Margin="5,5,0,5" HorizontalAlignment="Left" Width="98" Visibility="Collapsed"/>
                                        </Grid>

                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <TextBlock Text="Lundi" MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="60" />
                                        <Grid>
                                            <ComboBox x:Name="cbxLundiPst" MinWidth="180" Height="26" FontSize="14" VerticalAlignment="Top" />
                                            <!--TextBlock  x:Name="TblIndicationLundiPst" Text="Poste" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray"/-->
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5,0,5,5">
                                        <TextBlock Text="Mardi"  MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="60" />
                                        <Grid>
                                            <ComboBox x:Name="cbxMardiPst" MinWidth="180" Height="26" FontSize="14" VerticalAlignment="Top" />
                                            <!--TextBlock  x:Name="TblIndicationMardiPst" Text="Poste " VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray"/-->
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5,0,5,5">
                                        <TextBlock Text="Mercredi"  MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="60"/>
                                        <Grid>
                                            <ComboBox x:Name="cbxMercrediPst" MinWidth="180" Height="26" FontSize="14" VerticalAlignment="Top" />
                                            <!--TextBlock  x:Name="TblIndicationMercrediPst" Text="Poste" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray"/-->
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5,0,5,5">
                                        <TextBlock Text="Jeudi"  MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="60"/>
                                        <Grid>
                                            <ComboBox x:Name="cbxJeudiPst" MinWidth="180" Height="26" FontSize="14" VerticalAlignment="Top" />
                                            <!--TextBlock  x:Name="TblIndicationJeudiPst" Text="Poste" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray"/-->
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5,0,5,5">
                                        <TextBlock Text="Vendredi"  MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="60"/>
                                        <Grid>
                                            <ComboBox x:Name="cbxVendrediPst" MinWidth="180" Height="26" FontSize="14" VerticalAlignment="Top" />
                                            <!--TextBlock  x:Name="TblIndicationVendrediPst" Text="Poste" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray"/-->
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5,0,5,5">
                                        <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="60" Text="Samedi" />
                                        <Grid>
                                            <ComboBox x:Name="cbxSamediPst" MinWidth="180" Height="26" FontSize="14" VerticalAlignment="Top" />
                                            <!--TextBlock  x:Name="TblIndicationSamediPst" Text="Poste" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray"/-->
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="5,0,5,5">
                                        <TextBlock MinWidth="25" Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="60" Text="Dimanche" />
                                        <Grid>
                                            <ComboBox x:Name="cbxDimanchePst" MinWidth="180" Height="26" FontSize="14" VerticalAlignment="Top" />
                                            <!--TextBlock  x:Name="TblIndicationDimanchePst" Text="Poste" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="Gray"/-->
                                        </Grid>
                                    </StackPanel>
                                    <Button x:Name="btnValiderHebdo" Content="VALIDER" />
                                </StackPanel>

                            </Expander>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <StackPanel>
                    <Grid Background="#FF09002B">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="PLANNING" Foreground="White"  FontSize="15" HorizontalContentAlignment="Center"/>
                            <TextBlock x:Name="tblNbAgentPlanning" Text=" Nombre d'affectations en cours de validité : " Foreground="LightSkyBlue" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" >
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Début :"  Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="40"/>
                                    <DatePicker  x:Name="dtpDebutSearch" FontSize="12" VerticalAlignment="Center" Text=""  Width="100" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Fin :"  Margin="0,5,5,5" VerticalAlignment="Center" Foreground="White" Width="40"/>
                                    <DatePicker  x:Name="dtpFinSearch" FontSize="12" VerticalAlignment="Center" Text=""  Width="100" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Orientation="Horizontal">
                            <TextBox x:Name="BtnAgentListeSearch" Width="150" Height="28" Style="{StaticResource SearchButtonRounded}" Grid.Column="2"/>
                            <Button x:Name="btnExportExcel" MinWidth="30" MinHeight="30" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="White" >
                                <Button.Background>
                                    <ImageBrush ImageSource="Logo_excel.png" Stretch="Uniform"/>
                                </Button.Background>
                            </Button>
                        </StackPanel>

                    </Grid>
                </StackPanel>
                <DataGrid x:Name="DgAgentPlanning" AutoGenerateColumns="True" >
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Cette semaine" Name="cmiThisW" />
                            <MenuItem Header="Semaine prochaine" Name="cmiNextW" />
                            <MenuItem Header="A ce poste " Name="cmiPostePlanning" >
                                <MenuItem Header="Cette semaine" Name="cmiThisWp" />
                                <MenuItem Header="Semaine prochaine" Name="cmiNextWp" />
                            </MenuItem>

                        </ContextMenu>
                    </DataGrid.ContextMenu>

                </DataGrid>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>
