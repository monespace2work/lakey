<UserControl x:Class="ProfilUser"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lakey"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid Background="{DynamicResource ThemeContentSurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="56"/>
                <RowDefinition />
            </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text=" PROFIL UTILISATEUR" FontSize="24" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource ThemeSectionHeaderTextBrush}"
                   Background="{DynamicResource ThemeSectionHeaderBrush}" Padding="8,4"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="DESIGNATION : " Margin="15,0,10,0"/>
                    <TextBox x:Name="tbxProfilnAME" Width="200"/>
                    <TextBlock Text="Id Niveau : " Margin="15,0,10,0"/>
                    <TextBox x:Name="tbxLevel" Width="30" Text="90" TextAlignment="Right" Padding="0,0,3,0" />
                    <TextBlock Text="DESCRIPTION : " Margin="15,0,10,0"/>
                    <TextBox x:Name="tbxProfildESCRIPT" Width="300"/>
                </StackPanel>

                <StackPanel Margin="10,0">
                    <StackPanel Orientation="Horizontal" Background="{DynamicResource ThemeCardBrush}">
                        <StackPanel Orientation="Horizontal" MinWidth="200">
                            <TextBlock Text="Parametres " FontWeight="Bold" FontSize="14"/>
                            <CheckBox x:Name="chbAllParam" Checked="CheckBox_Checked" Background="#FF8BA9FF"  />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" MinWidth="120">
                            <TextBlock Text="Voir/Lecture" FontWeight="Bold" FontSize="14"/>
                            <CheckBox x:Name="chbRead" Background="#FF8BA9FF" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" MinWidth="120">
                            <TextBlock Text="Créer/Ajouter"  FontWeight="Bold" FontSize="14"/>
                            <CheckBox x:Name="chbAdd" Background="#FF8BA9FF" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" MinWidth="120">
                            <TextBlock Text="Modifier"  FontWeight="Bold" FontSize="14"/>
                            <CheckBox x:Name="chbModif" Background="#FF8BA9FF" />
                    </StackPanel>
                        <StackPanel Orientation="Horizontal" MinWidth="120">
                            <TextBlock Text="Supprimer" FontWeight="Bold" FontSize="14"/>
                            <CheckBox x:Name="chbDel" Background="#FF8BA9FF" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Background="#E5001144" >
                        <TextBlock Text="Utilisateur" MinWidth="200" Foreground="White" Padding="0,3" Margin="5,0,0,0" />
                        <CheckBox x:Name="chbReadUser" MinWidth="120" IsChecked="True" Margin="0,5,0,0"/>
                        <CheckBox x:Name="chbAddUser"  MinWidth="120" Margin="0,5,0,0"/>
                        <CheckBox x:Name="chbModifUser"  MinWidth="120" Margin="0,5,0,0"/>
                        <CheckBox x:Name="chbDelUser"  MinWidth="120" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Background="#9953659B"  >
                        <TextBlock Text="Données générales/Globales" MinWidth="200" Foreground="White" Padding="0,3" Margin="5,0,0,0" />
                        <CheckBox x:Name="chbReadGlobal" MinWidth="120" IsChecked="True" Margin="0,5,0,0"/>
                        <CheckBox x:Name="chbAddGlobal"  MinWidth="120" Margin="0,5,0,0"/>
                        <CheckBox x:Name="chbModifGlobal"  MinWidth="120" Margin="0,5,0,0"/>
                        <CheckBox x:Name="chbDelGlobal"  MinWidth="120" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Background="#E5001144"  >
                        <TextBlock Text="Données de la société/structure" MinWidth="200" Foreground="White" Padding="0,3" Margin="5,0,0,0" />
                        <CheckBox x:Name="chbReadSociety" MinWidth="120" IsChecked="True" Margin="0,5,0,0"/>
                        <CheckBox x:Name="chbAddSociety"  MinWidth="120" Margin="0,5,0,0"/>
                        <CheckBox x:Name="chbModifSociety"  MinWidth="120" Margin="0,5,0,0"/>
                        <CheckBox x:Name="chbDelSociety"  MinWidth="120" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Background="#9953659B" >
                        <TextBlock Text="Données ordinaires" MinWidth="200" Foreground="White" Padding="0,3" Margin="5,0,0,0" />
                        <CheckBox x:Name="chbReadOrdinary" MinWidth="120" IsChecked="True" Margin="0,5,0,0"/>
                        <CheckBox x:Name="chbAddOrdinary"  MinWidth="120" Margin="0,5,0,0"/>
                        <CheckBox x:Name="chbModifOrdinary"  MinWidth="120" Margin="0,5,0,0"/>
                        <CheckBox x:Name="chbDelOrdinary"  MinWidth="120" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Background="#E5001144"  >
                        <TextBlock Text="Données comptables" MinWidth="200" Foreground="White" Padding="0,3" Margin="5,0,0,0" />
                        <CheckBox x:Name="chbReadSpecial" MinWidth="120" IsChecked="True" Margin="0,5,0,0"/>
                        <CheckBox x:Name="chbAddSpecial"  MinWidth="120" Margin="0,5,0,0"/>
                        <CheckBox x:Name="chbModifSpecial"  MinWidth="120" Margin="0,5,0,0"/>
                        <CheckBox x:Name="chbDelSpecial"  MinWidth="120" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                        <Button  x:Name="btnCancel" Content=" Annuler " Width="100" Margin="10" />
                        <Button x:Name="btnValidNewFontion" Content="AJOUTER" Width="100" Height="36" HorizontalContentAlignment="Center" Margin="10"  Background="{DynamicResource ThemeActionSuccessBrush}" Foreground="{DynamicResource ThemeActionSuccessTextBrush}"/>
                        <Button x:Name="btnDelete" Content=" SUPPRIMER " Width="100" Margin="10" Foreground="{DynamicResource ThemeActionDangerTextBrush}" Background="{DynamicResource ThemeActionDangerBrush}" />

                    </StackPanel>

                </StackPanel>
                <DataGrid x:Name="dgProfil" AutoGenerateColumns="True" Margin="5,10,5,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
