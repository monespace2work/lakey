<UserControl x:Class="GeneralSets"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Lakey"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <StackPanel>
        <StackPanel.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF368265" Offset="0.253"/>
                <GradientStop Color="#FF0F583B" Offset="0"/>
                <GradientStop Color="#FF003722" Offset="0.987"/>
                <GradientStop Color="#FF368265" Offset="0.68"/>
            </LinearGradientBrush>
        </StackPanel.Background>
        <TextBlock TextWrapping="Wrap" Text="Paramètres Généraux" FontSize="22" Foreground="#FFD1F9F6" Margin="20,5,0,10" HorizontalAlignment="Center"/>

        <Expander Header="Paramètres de base" Foreground="#FFD1F9F6" FontSize="18" Background="#4C112064" BorderBrush="#FF162878" Margin="10,5,10,0" >
            <StackPanel Margin="10,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MaxWidth="750"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                            <TextBlock  Text="Chemin de la Base :" Foreground="White" Width="150" Margin="5,0,0,0" FontSize="12"/>
                            <TextBox x:Name="TbxDBpath" MinWidth="240" IsReadOnly="True" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                            <TextBlock Foreground="White" Width="150" Margin="5,0,0,0" FontSize="12"><Run Text="Dossier de récupération"/><Run Text=" :"/></TextBlock>
                            <TextBox x:Name="TbxRecupFolder"  MinWidth="240" IsReadOnly="True" FontSize="12"/>
                        </StackPanel>
                        <!--StackPanel Orientation="Horizontal"  Margin="0,0,0,10" >
                            <TextBlock  Text="Logo :" Foreground="White" Width="150" Margin="5,0,0,0" FontSize="12"/>
                            <TextBox x:Name="TbxLogopath" MinWidth="240" VerticalAlignment="Top" IsReadOnly="True" FontSize="12"/>
                        </StackPanel-->

                    </StackPanel>
                    <StackPanel Grid.Column="1"  HorizontalAlignment="Left">

                    </StackPanel>
                </Grid>
                <Button x:Name="btnSaveBase"   Content="Valider les modifications" Margin="40,5,40,5" Width="250" Height="30" FontSize="14" FontWeight="Bold" Foreground="White" Background="#FF115A3D" BorderBrush="#FFC8F0FF" />

            </StackPanel>

        </Expander>
        <Expander Header="DATE ET AGES" Foreground="#FFD1F9F6" FontSize="14" Background="#4C112064" BorderBrush="#FF162878" Margin="10,5,10,0">
            <StackPanel Margin="10,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MaxWidth="450"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                            <TextBlock Foreground="White" Width="180" Margin="5,0,0,0" FontSize="12" Text="Date de création :" VerticalAlignment="Center"/>
                            <DatePicker x:Name="DtpDateCreationSociete" MinWidth="115" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                            <TextBlock Foreground="White" Width="180" Margin="5,0,0,0" FontSize="12" Text="Age minimum d'embauche : "/>
                            <TextBox x:Name="TbxAgeMinEmbauche"  Width="30" FontSize="12" Text="18" TextAlignment="Right" Padding="0,0,3,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10" >
                            <TextBlock  Text="Age de retraite :" Foreground="White" Width="180" Margin="5,0,0,0" FontSize="12"/>
                            <TextBox x:Name="TbxAgeRetraite" Width="30" VerticalAlignment="Top" FontSize="12" Text="55" TextAlignment="Right" Padding="0,0,3,0"/>
                        </StackPanel>

                    </StackPanel>
                    <StackPanel Grid.Column="1"  HorizontalAlignment="Left" Margin="10,0">
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                            <TextBlock Foreground="White" Width="150" Margin="5,0,0,0" FontSize="12" Text="Début de période :" VerticalAlignment="Center"/>
                            <TextBox x:Name="TbxDatDebutEtatFinancierMensuel" Width="30" FontSize="12" Text="25" VerticalAlignment="Center"  TextAlignment="Right" Padding="0,0,3,0" Height="25"/>
                            <ComboBox x:Name="cbxMoisDébut"  SelectedIndex="0"  >
                                <ComboBoxItem Content="Mois précédent" />
                                <ComboBoxItem Content="Mois encours"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                            <TextBlock Foreground="White" Width="150" Margin="5,0,0,0" FontSize="12" Text="Début de période :" VerticalAlignment="Center"/>
                            <TextBox x:Name="TbxDateFinEtatFinancierMensuel" Width="30" FontSize="12" Text="24"  TextAlignment="Right" Padding="0,0,3,0" Height="25" VerticalAlignment="Bottom"/>
                            <ComboBox x:Name="cbxMoisFin" SelectedIndex="1"  >
                                <ComboBoxItem Content="Mois précédent" />
                                <ComboBoxItem Content="Mois encours"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                            <TextBlock Foreground="White" Width="150" Margin="5,0,0,0" FontSize="12" Text="Jours de congé mensuel :" VerticalAlignment="Center"/>
                            <TextBox x:Name="TbxNbJrDeCongeMensuel" Width="30" FontSize="12" Text="2.5"  TextAlignment="Right" Padding="0,0,3,0" VerticalAlignment="Bottom"/>
                        </StackPanel>

                    </StackPanel>
                </Grid>
                <Button x:Name="btnSaveDateAge"  Content="Valider les modifications" Margin="40,5,40,5" Width="250" Height="30" FontSize="14" FontWeight="Bold" Foreground="White" Background="#FF115A3D" BorderBrush="#FFC8F0FF" />

            </StackPanel>

        </Expander>
        <Expander Header="SALAIRE ET ASSOCIES" Foreground="#FFD1F9F6" FontSize="16" Background="#4C112064" BorderBrush="#FF162878" Margin="10,5,10,0" >
            <StackPanel Margin="10,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                            <TextBlock  Text="Salaire de base :" Foreground="White" Width="150" Margin="5,0,0,0" FontSize="12"/>
                            <TextBox x:Name="TbxMontantSalaireBase" Width="100" FontSize="12" TextAlignment="Right" Padding="0,0,3,0"/>
                            <TextBlock Text=" F CFA" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                            <TextBlock Text="Salaire Min. Gararantie :" Foreground="White" Width="150" Margin="5,0,0,0" FontSize="12"/>
                            <TextBox x:Name="TbxMontantSMIG"   Width="100" FontSize="12" TextAlignment="Right" Padding="0,0,3,0"/>
                            <TextBlock Text=" F CFA" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10" >
                            <TextBlock  Text="Salaire min. net :" Foreground="White" Width="150" Margin="5,0,0,0" FontSize="12"/>
                            <TextBox x:Name="TbxMontantSalaireNet"  Width="100" FontSize="12" TextAlignment="Right" Padding="0,0,3,0"/>
                            <TextBlock Text=" F CFA" FontSize="12" />
                        </StackPanel>

                    </StackPanel>
                    <Border  Width="2" Background="#4CDADADA" Margin="10,0"/>
                    <StackPanel  HorizontalAlignment="Left" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                            <TextBlock  Text="Taux CNSS - Patronal :" Foreground="White" Width="150" Margin="5,0,0,0" FontSize="12"/>
                            <TextBox x:Name="TbxTauxCNSSpatronal"  Width="30" FontSize="12" Text="22.5" TextAlignment="Right" Padding="0,0,2,0"/>
                            <TextBlock Text=" %" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                            <TextBlock Text="Taux CNSS - Employé :" Foreground="White" Width="150" Margin="5,0,0,0" FontSize="12"/>
                            <TextBox x:Name="TbxTauxCNSSemploye"    Width="30" FontSize="12" Text="9" TextAlignment="Right" Padding="0,0,2,0"/>
                            <TextBlock Text=" %" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10" >
                            <TextBlock  Text="Taux - impôt sur revenu :" Foreground="White" Width="150" Margin="5,0,0,0" FontSize="12"/>
                            <TextBox x:Name="tbxTauxIRPP"  Width="30" FontSize="12" Text="0" TextAlignment="Right" Padding="0,0,2,0"/>
                            <TextBlock Text=" %" FontSize="12" />
                        </StackPanel>

                    </StackPanel>
                </StackPanel>
                <Button x:Name="btnSaveSalaires"  Content="Valider les modifications" Margin="40,5,40,5" Width="250" Height="30" FontSize="14" FontWeight="Bold" Foreground="White" Background="#FF115A3D" BorderBrush="#FFC8F0FF" />

            </StackPanel>

        </Expander>
        <Expander Header="FACTURATION" Foreground="#FFD1F9F6" FontSize="16" Background="#4C112064" BorderBrush="#FF162878" Margin="10,5,10,0" >
            <StackPanel Margin="10,10,0,0">
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                            <TextBlock  Text="Prix unit. - Société :" Foreground="White" Width="150" Margin="5,0,0,0" FontSize="12"/>
                            <TextBox x:Name="TbxFacturePUsociete" Width="100" FontSize="12" TextAlignment="Right" Padding="0,0,3,0"/>
                            <TextBlock Text=" F CFA" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                            <TextBlock Text="Prix unit. - Patriculier :" Foreground="White" Width="150" Margin="5,0,0,0" FontSize="12"/>
                            <TextBox x:Name="TbxFacturePUparticurier"   Width="100" FontSize="12" TextAlignment="Right" Padding="0,0,3,0"/>
                            <TextBlock Text=" F CFA" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10" >
                            <TextBlock  Text="Prix unit. - Minimum :" Foreground="White" Width="150" Margin="5,0,0,0" FontSize="12"/>
                            <TextBox x:Name="TbxFacturePUminimum"  Width="100" FontSize="12" TextAlignment="Right" Padding="0,0,3,0"/>
                            <TextBlock Text=" F CFA" FontSize="12" />
                        </StackPanel>

                    </StackPanel>
                    <Border  Width="2" Background="#4CDADADA" Margin="10,0"/>
                    <StackPanel  HorizontalAlignment="Left" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                            <TextBlock  Text="Taux TVA :" Foreground="White" Width="150" Margin="5,0,0,0" FontSize="12"/>
                            <TextBox x:Name="TbxTauxTVA"  Width="30" FontSize="12" Text="18" TextAlignment="Right" Padding="0,0,2,0"/>
                            <TextBlock Text=" %" FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"  Margin="0,0,0,10">
                            <TextBlock Text="Taux de réduction :" Foreground="White" Width="150" Margin="5,0,0,0" FontSize="12"/>
                            <TextBox x:Name="TbxTauxReduction"    Width="30" FontSize="12" Text="0" TextAlignment="Right" Padding="0,0,2,0"/>
                            <TextBlock Text=" %" FontSize="12" />
                        </StackPanel>
                        <!--StackPanel Orientation="Horizontal"  Margin="0,0,0,10" >
                            <TextBlock  Text="Taux - impôt sur revenu :" Foreground="White" Width="150" Margin="5,0,0,0" FontSize="12"/>
                            <TextBox x:Name="tbxTaux3"  Width="30" FontSize="12" Text="0" TextAlignment="Right" Padding="0,0,2,0"/>
                            <TextBlock Text=" %" FontSize="12" />
                        </StackPanel-->

                    </StackPanel>
                </StackPanel>
                <Button x:Name="btnSaveFacturation"  Content="Valider les modifications" Margin="40,5,40,5" Width="250" Height="30" FontSize="14" FontWeight="Bold" Foreground="White" Background="#FF115A3D" BorderBrush="#FFC8F0FF" />

            </StackPanel>

        </Expander>

    </StackPanel>
</UserControl>
