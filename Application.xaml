<Application x:Class="Application"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Lakey"
    StartupUri="Login.xaml"
ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#E7EEF2"/>
        <SolidColorBrush x:Key="ThemeCardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeInkBrush" Color="#1E293B"/>
        <SolidColorBrush x:Key="ThemeNavyBrush" Color="#00113E"/>
        <SolidColorBrush x:Key="ThemeHeaderBrush" Color="#557E94"/>
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="#00CFCB"/>
        <SolidColorBrush x:Key="ThemeAccentSoftBrush" Color="#D1F9F6"/>
        <SolidColorBrush x:Key="ThemeBorderBrush" Color="#B9C8D0"/>
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource ThemeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeInkBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="UserControl">
            <Setter Property="Background" Value="{StaticResource ThemeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeInkBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Border" >
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
        </Style>
        <Style x:Key="SectionHeaderBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ThemeNavyBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeHeaderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource ThemeInkBrush}"/>
            <Setter Property="Background" Value="{StaticResource ThemeCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource ThemeInkBrush}"/>
            <Setter Property="Background" Value="{StaticResource ThemeCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource ThemeInkBrush}"/>
            <Setter Property="Background" Value="{StaticResource ThemeCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource ThemeInkBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{StaticResource ThemeNavyBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeNavyBrush}"/>
            <Setter Property="Background" Value="#E7EEF2"/>
            <Setter Property="MinHeight" Value="32"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.78"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="btnStandars" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="3,4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,7"/>

        </Style>
        <Style TargetType="Button" x:Key="btnSousStand" BasedOn="{StaticResource btnStandars}">
            <Setter Property="FontStretch" Value="Medium"/>
            <Setter Property="Background" Value="{StaticResource ThemeSurfaceBrush}"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DCE5ED"/>
        </Style>
        <!-- Define the Button style -->
        <Style TargetType="Button" x:Key="RoundedButtonWithImage">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15"
                                Padding="10"
                                SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                       Width="24" Height="24" Margin="0,0,10,0"/>
                                <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" FontSize="16"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="LightBlue"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="LightGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="RoundedButtonWithImageAtRight">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="15"
                                Padding="10"
                                SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                                       Width="24" Height="24" Margin="10,0,0,0"/>
                                <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" FontSize="16" Margin="10,0,0,0" />
                                </StackPanel>


                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="LightBlue"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="LightGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Bouton information-->
        <Style TargetType="Button" x:Key="btnInfos">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0" Opacity="0.90">
                        <GradientStop Color="Black" Offset="1"/>
                        <GradientStop Color="#FF00113E" Offset="0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFCBFFE1"/>

        </Style>
        <!-- Define the ControlTemplate for the TextBox -->
        <ControlTemplate x:Key="SearchTextBoxTemplate" TargetType="TextBox">
            <Grid>
                <!-- Rounded border -->
                <Border x:Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="15">
                    <Grid>
                        <!-- Placeholder for the TextBox content -->
                        <ScrollViewer Margin="5"
                                      x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                </Border>
                <!-- Search icon on the right -->
                <Button Width="24"
                        Height="24"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,5,0"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        Focusable="False">
                    <Path Data="M15.5,14H14.71l-.26-.27A6.471,6.471,0,0,0,16,9.5,6.5,6.5,0,1,0,9.5,16,6.471,6.471,0,0,0,13.73,14.45l.27.26V15.5l4.25,4.25A1,1,0,0,0,19.5,18.5ZM9.5,14A4.5,4.5,0,1,1,14,9.5,4.5,4.5,0,0,1,9.5,14Z"
                          Fill="Gray" />
                </Button>
                
            </Grid>
        </ControlTemplate>

        <!-- Style for the TextBox to use the custom ControlTemplate -->
        <Style x:Key="SearchButtonRounded" TargetType="TextBox">
            <Setter Property="Template" Value="{StaticResource SearchTextBoxTemplate}" />
            <Setter Property="Padding" Value="5,0,30,0" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border                         Background="#FF00113E"
                                BorderBrush="#FFCBD5E1"
                                BorderThickness="1" 
                                CornerRadius="5"
                                Padding="5"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"
                                                  SnapsToDevicePixels="True"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <!-- Style for DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeInkBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#E7EEF2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Application.Resources>
</Application>
